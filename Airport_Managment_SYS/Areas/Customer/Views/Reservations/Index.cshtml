@model IEnumerable<Airport_Managment_SYS.Models.Reservation>

@{
 Layout = "~/Views/Shared/_customer_layout.cshtml";
 ViewData["Title"] = "My Reservations";
}

<div class="container mt-5">
 <div class="d-flex justify-content-between align-items-center mb-4">
 <h2 class="mb-0">My Reservations</h2>
 <div class="text-end">
 <span class="fw-semibold">Total:</span>
 <span class="fs-4 text-primary">@((decimal)ViewBag.TotalPrice).ToString("C")</span>
 </div>
 </div>

 @if (!Model.Any())
 {
 <div class="alert alert-info">You have no reservations yet.</div>
 }

 <div class="row g-3">
 @foreach(var r in Model)
 {
 <div class="col-md-6">
 <div class="card h-100">
 <div class="card-body">
 <h5 class="card-title">Trip #@r.TripId</h5>
 <p class="card-text mb-1"><strong>Date:</strong> @(r.Trip?.DateTime.ToString("f") ?? "-")</p>
 <p class="card-text mb-1"><strong>Price:</strong> @(r.Trip != null ? ((decimal)r.Trip.Price).ToString("C") : "-")</p>
 <a class="btn btn-sm btn-primary" asp-area="Customer" asp-controller="Reservations" asp-action="Details" asp-route-tripId="@r.TripId">View Details</a>
 </div>
 </div>
 </div>
 }
 </div>
</div>
