@model Airport_Managment_SYS.Areas.Customer.ViewModels.HomeVM

@{
    Layout = "_customer_layout";
}

<main class="flex-grow-1">
    <!-- Hero Section -->
    <section class="hero-section hero-fullwidth">
        <div class="hero-bg"></div>
        <div class="hero-overlay"></div>

        <div class="container-fluid position-relative px-0" style="z-index: 2;">
            <div class="container" style="max-width: 1400px; margin: 0 auto;">

                <div class="row justify-content-center">
                    <div class="col-12 col-lg-10 col-xl-8">
                        <!-- Title -->
                        <div class="text-center mb-5">
                            <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill border border-primary border-opacity-25 bg-primary bg-opacity-10 mb-4">
                                <span class="pulse-dot"></span>
                                <span class="text-primary text-uppercase fw-bold" style="font-size: 0.625rem; letter-spacing: 0.2em;">Redefining Modern Travel</span>
                            </div>

                            <h1 class="hero-title glow-text mb-4">
                                The Distance is No Longer<br />
                                <span class="gradient-text">The Limit</span>
                            </h1>

                            <p class="text-white-50 fs-5 mb-0 mx-auto" style="max-width: 700px;">
                                Experience the pinnacle of aviation with SkyStream. Seamless booking meets futuristic comfort.
                            </p>
                        </div>

                        <!-- Search Card -->
                        <div class="glass-card rounded-4 p-4 p-md-5 shadow-lg">
                            <form asp-area="Customer"
                                  asp-controller="Home"
                                  asp-action="SearchTrips"
                                  method="get">
                                <div class="row g-3">
                                    <!-- From -->
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label text-uppercase fw-bold text-white-50 mb-1" style="font-size: 0.625rem; letter-spacing: 0.1em;">From</label>
                                        <div class="glass-input rounded-3 d-flex align-items-center px-3" style="height: 56px;">
                                            <i class="bi bi-airplane-fill text-white-50 me-2"></i>
                                            <select asp-for="SearchTripsVM.DepartureCity"
                                                    class="form-select bg-transparent border-0 shadow-none text-white fw-semibold p-0"
                                                    style="background-image: none; padding-right: 0;">
                                                <option class="bg-dark" value="">Select Departure</option>
                                                @foreach (var state in Model.SearchTripsVM.States!)
                                                {
                                                    <option class="bg-dark" value="@state.Id">@state.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <span asp-validation-for="SearchTripsVM.DepartureCity" class="text-danger small"></span>
                                    </div>

                                    <!-- To -->
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label text-uppercase fw-bold text-white-50 mb-1" style="font-size: 0.625rem; letter-spacing: 0.1em;">To</label>
                                        <div class="glass-input rounded-3 d-flex align-items-center px-3" style="height: 56px;">
                                            <i class="bi bi-airplane-engines-fill text-white-50 me-2"></i>
                                            <select asp-for="SearchTripsVM.ArrivalCity"
                                                    class="form-select bg-transparent border-0 shadow-none text-white fw-semibold p-0"
                                                    style="background-image: none; padding-right: 0;">
                                                <option class="bg-dark" value="">Select Destination</option>
                                                @foreach (var state in Model.SearchTripsVM.States!)
                                                {
                                                    <option class="bg-dark"
                                                            value="@state.Id"
                                                            selected="@(Model.SearchTripsVM.ArrivalCity == state.Id)">
                                                        @state.Name
                                                    </option>
                                                }
                                            </select>
                                        </div>
                                        <span asp-validation-for="SearchTripsVM.ArrivalCity" class="text-danger small"></span>
                                    </div>

                                    <!-- Date -->
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label text-uppercase fw-bold text-white-50 mb-1" style="font-size: 0.625rem; letter-spacing: 0.1em;">Departure Date</label>
                                        <div class="glass-input rounded-3 d-flex align-items-center px-3" style="height: 56px;">
                                            <i class="bi bi-calendar3 text-white-50 me-2"></i>
                                            <input asp-for="SearchTripsVM.DepartureTime"
                                                   type="date"
                                                   min="@DateTime.UtcNow.ToString("yyyy-MM-dd")"
                                                   value="@DateTime.UtcNow.ToString("yyyy-MM-dd")"
                                                   class="form-control bg-transparent border-0 shadow-none text-white fw-semibold p-0" />
                                        </div>
                                        <span asp-validation-for="SearchTripsVM.DepartureTime" class="text-danger small"></span>
                                    </div>

                                    <!-- Search Button -->
                                    <div class="col-12 col-md-6 col-lg-3 d-flex align-items-end">
                                        <button type="submit"
                                                class="btn btn-primary w-100 fw-bold d-flex align-items-center justify-content-center gap-2"
                                                style="height: 56px;">
                                            <i class="bi bi-search"></i>
                                            Search Flights
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Active Reservations Section -->
        <section class="container py-5 my-5">
            <div class="mb-5">
                <div class="d-flex flex-column flex-md-row align-items-start align-items-md-end justify-content-between gap-3 mb-4">
                    <div>
                        <p class="text-primary fw-bold text-uppercase mb-1" style="font-size: 0.625rem; letter-spacing: 0.3em;">Your Itinerary</p>
                        <h3 class="display-6 fw-bold text-white mb-0" style="letter-spacing: -0.02em;">Active Reservations</h3>
                    </div>
                    <a href="#" class="text-white-50 text-decoration-none d-flex align-items-center gap-2 hover-white transition-all">
                        <span class="text-uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.1em;">View all voyages</span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>

                @if (Model.reservations == null || !Model.reservations.Any())
                {
                    <div class="text-center py-5 text-white-50">
                        <p class="fs-4 mb-0">You don't have any active reservations yet.</p>
                    </div>
                }
                else
                {
                    <!-- Horizontal Scrollable Carousel -->
                    <div class="overflow-hidden">
                        <div id="reservations-slider"
                             class="d-flex gap-4 overflow-auto pb-4 snap-scroll scrollbar-hide"
                             style="scroll-behavior: smooth;">

                            @foreach (var reservation in Model.reservations)
                            {
                                var trip = reservation.Trip;

                                <div class="flex-shrink-0 snap-item" style="min-width: 85%; max-width: 450px;">
                                    <div class="glass-card rounded-4 overflow-hidden shadow-lg">
                                        <div class="row g-0">
                                            <!-- Image -->
                                            <div class="col-12 col-md-5 position-relative" style="min-height: 280px;">
                                                <img src="https://picsum.photos/id/1015/800/600"
                                                     class="w-100 h-100 object-fit-cover position-absolute"
                                                     style="top: 0; left: 0;"
                                                     alt="Destination Image">
                                                <div class="position-absolute" style="inset: 0; background: linear-gradient(to right, rgba(0,0,0,0.7), transparent);"></div>

                                                <div class="position-absolute top-0 start-0 p-3">
                                                    <span class="badge bg-success rounded-pill px-3 py-2 text-uppercase fw-bold" style="font-size: 0.625rem; letter-spacing: 0.1em;">
                                                        ACTIVE
                                                    </span>
                                                </div>
                                            </div>

                                            <!-- Content -->
                                            <div class="col-12 col-md-7 p-4 p-md-5 d-flex flex-column justify-content-between" style="background-color: #0a1428;">
                                                <div>
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div>
                                                            <h4 class="fw-bold text-white h3 mb-1">
                                                                @trip?.Airport_To?.GovernerateState?.Name
                                                            </h4>
                                                            <p class="text-white-50 small mb-0">
                                                                Flight @(trip?.Id.ToString() ?? "1") &bull; Departing @(trip?.DateTime.ToString("MMMM dd") ?? "March 22")
                                                            </p>
                                                        </div>
                                                        <div class="text-end">
                                                            <span class="d-block text-uppercase fw-semibold text-info" style="font-size: 0.625rem; letter-spacing: 1px;">BOARDING GATE</span>
                                                            <span class="display-6 fw-bold text-white">@(trip?.Airport_From.Name ?? "Borg El Arab")</span>
                                                        </div>
                                                    </div>

                                                    <!-- Progress -->
                                                    <div class="mt-4">
                                                        <div class="d-flex justify-content-between text-uppercase text-white-50 mb-2" style="font-size: 0.625rem; letter-spacing: 0.1em;">
                                                            <span>Preparation Status</span>
                                                            <span>65% Complete</span>
                                                        </div>
                                                        <div class="progress" style="height: 8px; background-color: #1f2937;">
                                                            <div class="progress-bar progress-gradient rounded-pill" role="progressbar" style="width: 65%"></div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="d-flex gap-4 mt-4 pt-3">
                                                
                                                    <a asp-area="Customer" asp-action="Index" asp-controller="Reservations"  class="text-white-50 text-decoration-none hover-white transition-all">Manage Trip</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- New Destinations Section -->
            <div class="mb-5">
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-4 mb-5 text-center text-md-start">
                    <div>
                        <p class="text-primary fw-bold text-uppercase mb-1" style="font-size: 0.625rem; letter-spacing: 0.3em;">Curated Experiences</p>
                        <h3 class="display-6 fw-bold text-white mb-0" style="letter-spacing: -0.02em;">New Destinations</h3>
                    </div>
                    <p class="text-white-50 mb-0" style="max-width: 350px;">Exclusive access to the world's most desired locales with signature SkyStream service.</p>
                </div>

                <div class="row g-4">
                    @if (Model.trips != null && Model.trips.Any())
                    {
                        foreach (var trip in Model.trips)
                        {
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="destination-card" style="aspect-ratio: 3/4;">
                                    <div class="card-bg"
                                         style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDemsvn13MhAz6QxDf_-IZq_g9XIp5h3Sql1NmYrOZjmYinKN8-Uh7yLgB-dRXruAoD-F7P1viY_u11Ho1wFsKjBwb9D3JC28UGxzjyvGywcApxw1bIfWGU2uTvq8OihRMhEWNoYaxWTwiPfFV_IbrHaRDOW8S8KmhENLVc2vHSJSNb_HXpkInUEwr4RuqwbGSms5ZszkevJ7YSSUYYJcgHE-ZYk5DtLSN9LBJCA1ST0fzFMOjrZyvLB6w1u0nh2JQP_zhER1I503s');">
                                    </div>
                                    <div class="card-overlay"></div>

                                    <div class="card-content">
                                        <div class="d-flex flex-column gap-3">
                                            <span class="badge bg-primary bg-opacity-20 text-primary border border-primary border-opacity-25 text-uppercase fw-bold w-fit" style="font-size: 0.5625rem; letter-spacing: 0.15em; backdrop-filter: blur(10px);">
                                                Destination
                                            </span>

                                            <div>
                                                <h4 class="fw-bold text-white mb-2" style="font-size: 1.75rem;">
                                                    @trip?.Airport_To?.GovernerateState?.Name
                                                </h4>
                                                <p class="text-white-50 small mb-0 hover-reveal" style="line-height: 1.6;">
                                                    Explore amazing السفر experience with premium comfort.
                                                </p>
                                            </div>

                                            <div class="d-flex align-items-center justify-content-between pt-3 border-top border-white border-opacity-10">
                                                <div class="d-flex flex-column">
                                                    <span class="text-uppercase fw-bold text-white-50" style="font-size: 0.5625rem; letter-spacing: 0.05em;">Starting At</span>
                                                    <span class="text-white fw-bold fs-4">$@trip.Price</span>
                                                </div>

                                                <div class="d-flex align-items-center justify-content-center rounded-circle border border-white border-opacity-20"
                                                     style="width: 40px; height: 40px; transition: all 0.3s ease;"
                                                     onmouseover="this.style.backgroundColor='white'; this.style.color='#0a1428';"
                                                     onmouseout="this.style.backgroundColor='transparent'; this.style.color='white';">
                                                    <i class="bi bi-arrow-up-right"></i>
                                                </div>
                                                <div class="d-flex gap-4 mt-4 pt-3">

                                                    <a asp-area="Customer" asp-action="Details" asp-controller="Home" asp-route-id="@trip.Id" class="text-white-50 text-decoration-none hover-white transition-all">View Trip</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center">
                            <p class="text-white fs-5">No Trips Available</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Technical Superiority Section -->
            <div class="position-relative overflow-hidden rounded-5" style="background: linear-gradient(to bottom right, #0f172a, #020617); border: 1px solid rgba(255, 255, 255, 0.05);">
                <div class="feature-glow"></div>
                <div class="position-relative">
                    <div class="row g-5 align-items-center p-4 p-lg-5">
                        <div class="col-12 col-lg-6">
                            <div class="mb-4">
                                <p class="text-primary fw-bold text-uppercase mb-2" style="font-size: 0.625rem; letter-spacing: 0.4em;">Technical Superiority</p>
                                <h3 class="display-5 fw-bold text-white mb-3" style="letter-spacing: -0.02em; line-height: 1.2;">A New Paradigm <br />in In-Flight Service</h3>
                                <p class="text-white-50 fs-5 mb-0" style="line-height: 1.6;">We combine aerospace engineering with bespoke luxury to create a travel environment that anticipates your every need.</p>
                            </div>

                            <div class="row g-4 mb-4">
                                <div class="col-12 col-sm-6">
                                    <div class="d-flex flex-column gap-3">
                                        <div class="d-flex align-items-center justify-content-center rounded-3 border border-white border-opacity-10"
                                             style="width: 56px; height: 56px; background: rgba(255,255,255,0.05); transition: all 0.3s ease;"
                                             onmouseover="this.style.borderColor='rgba(13, 110, 253, 0.5)'"
                                             onmouseout="this.style.borderColor='rgba(255,255,255,0.1)'">
                                            <i class="bi bi-globe text-primary fs-3"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold text-white h5 mb-1">Global Neural Link</h5>
                                            <p class="text-white-50 small mb-0" style="line-height: 1.6;">Quantum-speed connectivity across all altitudes and continents.</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <div class="d-flex flex-column gap-3">
                                        <div class="d-flex align-items-center justify-content-center rounded-3 border border-white border-opacity-10"
                                             style="width: 56px; height: 56px; background: rgba(255,255,255,0.05); transition: all 0.3s ease;"
                                             onmouseover="this.style.borderColor='rgba(13, 110, 253, 0.5)'"
                                             onmouseout="this.style.borderColor='rgba(255,255,255,0.1)'">
                                            <i class="bi bi-stars text-primary fs-3"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold text-white h5 mb-1">Smart Cabin AI</h5>
                                            <p class="text-white-50 small mb-0" style="line-height: 1.6;">Dynamic environment control tailored to your biological clock.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <a href="#" class="btn btn-light text-dark fw-bold text-uppercase d-inline-flex align-items-center gap-3 rounded-3 btn-glow px-4 py-3" style="font-size: 0.75rem; letter-spacing: 0.1em;">
                                Explore Technology
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="position-relative">
                                <div class="position-absolute" style="inset: -4px; background: linear-gradient(to right, rgba(13, 110, 253, 0.3), rgba(13, 202, 240, 0.3)); border-radius: 1.5rem; filter: blur(8px); opacity: 0.3; transition: opacity 0.3s ease;"
                                     onmouseover="this.style.opacity='0.5'"
                                     onmouseout="this.style.opacity='0.3'"></div>
                                <div class="position-relative rounded-4 overflow-hidden border border-white border-opacity-10 shadow-lg">
                                    <img alt="Airline Service Experience"
                                         class="w-100 img-hover-scale"
                                         style="opacity: 0.9;"
                                         src="https://lh3.googleusercontent.com/aida-public/AB6AXuBxiDukFdaxk2jsNSsZQc1HChDyfGT88DeaDcbrGv3_CsEOL8INLRUpJGDGNC2TCEMWta7IsTNtJ3gWHCyClso940dl1dTH-_N7tAYO_CUEHlv68j0E9ATalcoH-S27_swk0aSiQy1DH7Y0SF3hUs9J-Cc1ejLDgnXgBgIkUJoUkddD2ci12yoOVnYG7Ln_mxOrsiadan4U5vuIYnXPnPVvys59fYrpS4O8GIiPyj_IxY-Q7cOw63AJ1o0KPmgPjgppKtZRynhBeoY" />
                                    <div class="position-absolute" style="inset: 0; background: linear-gradient(to top right, rgba(10, 20, 40, 0.8), transparent);"></div>
                                    <div class="position-absolute bottom-0 start-0 p-3 p-md-4">
                                        <div class="glass-card rounded-3 p-3 d-flex align-items-center gap-3">
                                            <div class="d-flex align-items-center justify-content-center rounded-2 bg-primary" style="width: 40px; height: 40px;">
                                                <i class="bi bi-patch-check-fill text-white"></i>
                                            </div>
                                            <div>
                                                <p class="text-uppercase fw-bold text-white-50 mb-0" style="font-size: 0.625rem; letter-spacing: 0.1em;">Award Winning</p>
                                                <p class="text-white fw-bold mb-0" style="font-size: 0.875rem;">Best Digital Airline 2024</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
        <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

        <script type="text/javascript">
            $(function () {
            if ('@TempData["info"]' != '') {
            toastr.info('@TempData["info"]');
            }
            });
        </script>
    }
