                            </div>

                            <div class="absolute inset-0 bg-gradient-to-t from-background-dark via-background-dark/20 to-transparent"></div>

                            <!-- Content -->
                            <div class="absolute bottom-0 p-8 w-full">
                                <div class="flex flex-col gap-4">

                                    <!-- Tag -->
                                    <span class="w-fit bg-primary/20 backdrop-blur-md text-primary text-[9px] font-bold px-3 py-1.5 rounded-full border border-primary/30 uppercase tracking-widest">
                                        Destination
                                    </span>

                                    <!-- Title -->
                                    <div>
                                        <h4 class="text-3xl font-800 text-white mb-2">
                                            @trip?.Airport_To?.GovernerateState?.Name 
                                        </h4>

                                        <p class="text-slate-400 text-sm leading-relaxed opacity-0 group-hover:opacity-100 transition-opacity duration-500 line-clamp-2">
                                            Explore amazing السفر experience with premium comfort.
                                        </p>
                                    </div>

                                    <!-- Price -->
                                    <div class="flex items-center justify-between pt-4 border-t border-white/10">
                                        <div class="flex flex-col">
                                            <span class="text-[10px] text-slate-500 uppercase font-bold tracking-tighter">
                                                Starting At
                                            </span>

                                            <span class="text-white font-800 text-xl tracking-tight">
                                                $@trip.Price 
                                            </span>
                                        </div>

                                        <div class="size-10 rounded-full border border-white/20 flex items-center justify-center group-hover:bg-white group-hover:text-background-dark transition-all duration-300">
                                            <span class="material-symbols-outlined text-lg">arrow_outward</span>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-white text-center col-span-3">No Trips Available</p>
                }

            </div></div>
                <div class="relative overflow-hidden rounded-[3rem] bg-gradient-to-br from-slate-900 to-slate-950 border border-white/5">
                    <div class="absolute top-0 right-0 w-1/2 h-full bg-primary/5 blur-[120px] rounded-full"></div>
                    <div class="relative flex flex-col lg:flex-row gap-16 p-12 lg:p-24 items-center">
                        <div class="w-full lg:w-1/2 space-y-10">
                            <div class="space-y-4">
                                <p class="text-primary font-bold tracking-[0.4em] uppercase text-[10px]">Technical Superiority</p>
                                <h3 class="text-5xl font-800 text-white leading-tight tracking-tighter">A New Paradigm <br />in In-Flight Service</h3>
                                <p class="text-slate-400 text-lg leading-relaxed">We combine aerospace engineering with bespoke luxury to create a travel environment that anticipates your every need.</p>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-12">
                                <div class="group space-y-4">
                                    <div class="size-14 bg-white/5 rounded-2xl flex items-center justify-center border border-white/10 group-hover:border-primary/50 transition-all">
                                        <span class="material-symbols-outlined text-primary text-3xl">language</span>
                                    </div>
                                    <div class="space-y-1">
                                        <h5 class="font-bold text-white text-lg">Global Neural Link</h5>
                                        <p class="text-sm text-slate-500 leading-relaxed">Quantum-speed connectivity across all altitudes and continents.</p>
                                    </div>
                                </div>
                                <div class="group space-y-4">
                                    <div class="size-14 bg-white/5 rounded-2xl flex items-center justify-center border border-white/10 group-hover:border-primary/50 transition-all">
                                        <span class="material-symbols-outlined text-primary text-3xl">auto_awesome</span>
                                    </div>
                                    <div class="space-y-1">
                                        <h5 class="font-bold text-white text-lg">Smart Cabin AI</h5>
                                        <p class="text-sm text-slate-500 leading-relaxed">Dynamic environment control tailored to your biological clock.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="pt-6">
                                <a class="inline-flex items-center gap-4 bg-white text-background-dark px-10 py-5 rounded-2xl font-800 tracking-widest text-xs uppercase hover:bg-primary hover:text-white transition-all glow-primary" href="#">
                                    Explore Technology
                                    <span class="material-symbols-outlined">arrow_forward</span>
                                </a>
                            </div>
                        </div>
                        <div class="w-full lg:w-1/2">
                            <div class="relative group">
                                <div class="absolute -inset-1 bg-gradient-to-r from-primary/50 to-accent/50 rounded-3xl blur opacity-25 group-hover:opacity-50 transition-all"></div>
                                <div class="relative rounded-3xl overflow-hidden border border-white/10 shadow-2xl">
                                    <img alt="Airline Service Experience" class="w-full h-auto object-cover opacity-90 group-hover:scale-105 transition-transform duration-[3s]" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBxiDukFdaxk2jsNSsZQc1HChDyfGT88DeaDcbrGv3_CsEOL8INLRUpJGDGNC2TCEMWta7IsTNtJ3gWHCyClso940dl1dTH-_N7tAYO_CUEHlv68j0E9ATalcoH-S27_swk0aSiQy1DH7Y0SF3hUs9J-Cc1ejLDgnXgBgIkUJoUkddD2ci12yoOVnYG7Ln_mxOrsiadan4U5vuIYnXPnPVvys59fYrpS4O8GIiPyj_IxY-Q7cOw63AJ1o0KPmgPjgppKtZRynhBeoY" />
                                    <div class="absolute inset-0 bg-gradient-to-tr from-background-dark/80 to-transparent"></div>
                                    <div class="absolute bottom-8 left-8">
                                        <div class="bg-white/10 backdrop-blur-xl p-4 rounded-xl border border-white/10 flex items-center gap-4">
                                            <div class="size-10 bg-primary rounded-lg flex items-center justify-center">
                                                <span class="material-symbols-outlined text-white">verified</span>
                                            </div>
                                            <div class="text-left">
                                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Award Winning</p>
                                                <p class="text-white font-800 text-sm">Best Digital Airline 2024</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </main>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <script type="text/javascript">
        $(function () {
            // Check if TempData has the info key
            if ('@TempData["info"]' != '') {
                toastr.info('@TempData["info"]');
            }
        });
    </script>
}
 
