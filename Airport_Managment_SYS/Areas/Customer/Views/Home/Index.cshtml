    <section class="relative w-screen min-h-[750px] flex flex-col items-center justify-center pt-12 pb-32 overflow-hidden -mx-[50vw] left-[50%] right-[50%]">

        <!-- Background -->
        <div class="absolute inset-0 z-0">
            <div class="absolute inset-0 bg-gradient-to-b from-background-dark/80 via-transparent to-background-dark z-10"></div>

            <div class="absolute inset-0 bg-cover bg-center scale-110 blur-[2px] opacity-40"
                 style='background-image: url("https://islamonline.net/wp-content/uploads/2022/06/Madinah-Mosque.jpg");'>            </div>
        </div>

        <!-- Content -->
        <div class="relative z-20 w-full max-w-7xl mx-auto px-6 flex flex-col items-center gap-12">

            <!-- Title -->
            <div class="text-center space-y-6">

                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-primary/30 bg-primary/10 text-primary text-[10px] font-bold tracking-[0.2em] uppercase">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
                    </span>
                    Redefining Modern Travel
                </div>

                <h1 class="text-white text-5xl md:text-8xl font-800 leading-tight tracking-tighter glow-text">
                    The Distance is No Longer<br /><span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">The Limit</span>
                </h1>

                <p class="text-slate-400 text-lg dark__text-white md:text-xl max-w-3xl mx-auto">
                    Experience the pinnacle of aviation with SkyStream. Seamless booking meets futuristic comfort.
                </p>

            </div>

            <!-- Search Card -->
            <div  class="w-full
            bg-white/10
            backdrop-blur-xl
            p-6 md:p-8
            rounded-2xl
            shadow-2xl
            border border-white/20
            hover:bg-white/15
            transition">

                <form asp-area="Customer"
                      asp-controller="Home"
                      asp-action="SearchTrips"
                      method="get"
                      class="grid grid-cols-1 md:grid-cols-4 gap-4">

                    <!-- From -->
                    <div>
                        <label class="block text-xs font-bold text-slate-300 uppercase mb-1">
                            From
                        </label>

                        <div class="border border-white/20 rounded-lg bg-white/10 backdrop-blur-md h-14 px-4 flex items-center text-white focus-within:border-primary transition">

                            <span class="material-symbols-outlined text-slate-300 mr-2">
                                flight_takeoff
                            </span>

                            <select asp-for="SearchTripsVM.DepartureCity"
                                    class="w-full bg-transparent border-none focus:ring-0 font-semibold text-white">

                                <option class="text-black" value="">Select Departure</option>

                                @foreach (var state in Model.SearchTripsVM.States!)
                                {
                                    <option class="text-black" value="@state.Id">
                                        @state.Name
                                    </option>
                                }

                            </select>
                        </div>

                        <span asp-validation-for="SearchTripsVM.DepartureCity"
                              class="text-red-400 text-sm"></span>
                    </div>

                    <!-- To -->
                    <div>
                        <label class="block text-xs font-bold text-slate-300 uppercase mb-1">
                            To
                        </label>

                        <div class="border border-white/20 rounded-lg bg-white/10 backdrop-blur-md h-14 px-4 flex items-center text-white focus-within:border-primary transition">

                            <span class="material-symbols-outlined text-slate-300 mr-2">
                                flight_land
                            </span>

                            <select asp-for="SearchTripsVM.ArrivalCity"
                                    class="w-full bg-transparent border-none focus:ring-0 font-semibold text-white">

                                <option class="text-black" value="">Select Destination</option>

                                @foreach (var state in Model.SearchTripsVM.States!)
                                {
                                    <option class="text-black"
                                            value="@state.Id"
                                            selected="@(Model.SearchTripsVM.ArrivalCity == state.Id)">
                                        @state.Name
                                    </option>
                                }

                            </select>
                        </div>

                        <span asp-validation-for="SearchTripsVM.ArrivalCity"
                              class="text-red-400 text-sm"></span>
                    </div>

                    <!-- Date -->
                    <div>
                        <label class="block text-xs font-bold text-slate-300 uppercase mb-1">
                            Departure Date
                        </label>

                        <div class="flex items-center border border-white/20 rounded-lg bg-white/10 backdrop-blur-md h-14 px-4 text-white focus-within:border-primary transition">

                            <span class="material-symbols-outlined text-slate-300 mr-2">
                                calendar_today
                            </span>

                            <input asp-for="SearchTripsVM.DepartureTime"
                                   type="date"
                                   min="@DateTime.UtcNow"
                                   value="@DateTime.UtcNow.Date"
                                   class="w-full border-none bg-transparent p-0 font-semibold focus:ring-0 text-white" />
                        </div>

                        <span asp-validation-for="SearchTripsVM.DepartureTime"
                              class="text-red-400 text-sm"></span>
                    </div>

                    <!-- Search Button -->
                    <div class="flex items-end">
                        <button type="submit"
                                class="w-full h-14 bg-primary text-white font-bold rounded-lg flex items-center justify-center gap-2 shadow-lg hover:opacity-90 transition">

                            <span class="material-symbols-outlined">
                                search
                            </span>

                            Search Flights

                        </button>
                    </div>

                </form>
            </div>
        </div>

    </section>       
    <section class="max-w-7xl mx-auto px-6 py-24">

        <div class="mb-32">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
                <div class="space-y-2">
                    <p class="text-primary font-bold tracking-[0.3em] uppercase text-[10px]">Your Itinerary</p>
                    <h3 class="text-4xl font-800 text-white tracking-tight">Active Reservations</h3>
                </div>
                <a href="#" class="group flex items-center gap-3 text-slate-400 hover:text-white transition-colors">
                    <span class="text-xs font-bold tracking-widest uppercase">View all voyages</span>
                    <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">arrow_forward_ios</span>
                </a>
            </div>

            @if (Model.reservations == null || !Model.reservations.Any())
            {
                <div class="text-center py-20 text-slate-400">
                    <p class="text-xl">You don't have any active reservations yet.</p>
                </div>
            }
            else
            {
                <!-- Horizontal Scrollable Carousel -->
                <div class="max-w-6xl mx-auto">
                    <div id="reservations-slider"
                         class="flex gap-6 overflow-x-auto pb-10 snap-x snap-mandatory scroll-smooth scrollbar-hide
                            touch-pan-x -webkit-overflow-scrolling-touch">

                        @foreach (var reservation in Model.reservations)
                        {
                            var trip = reservation.Trip;

                            <div class="min-w-[90%] md:min-w-[420px] lg:min-w-[450px] flex-shrink-0 snap-center">
                                <div class="glass-card rounded-3xl overflow-hidden border border-white/10 hover:border-primary/40 transition-all duration-300 shadow-xl">
                                    <div class="flex flex-col md:flex-row">

                                        <!-- Image -->
                                        <div class="md:w-5/12 relative h-72 md:h-auto overflow-hidden">
                                            <img src="https://picsum.photos/id/1015/800/600"
                                                 class=" h-100 w-100 object-cover transition-transform duration-700 hover:scale-110"
                                                 alt="Destination Image">
                                            <div class="absolute inset-0 bg-gradient-to-r from-black/70 to-transparent"></div>

                                            <div class="absolute top-6 left-6">
                                                <span class="px-6 py-2 bg-emerald-600 text-white text-xs font-bold rounded-2xl tracking-wider">
                                                    ACTIVE
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Content -->
                                        <div class="md:w-7/12 p-8 md:p-10 bg-[#0a1428] flex flex-col justify-between">
                                            <div>
                                                <div class="flex justify-between">
                                                    <div>
                                                        <h4 class="text-3xl font-bold text-white">
                                                            @trip?.Airport_To?.GovernerateState?.Name 
                                                        </h4>
                                                        <p class="text-slate-400 mt-1">
                                                            Flight @(trip?.Id.ToString() ?? "1") • Departing @(trip?.DateTime.ToString("MMMM dd") ?? "March 22")
                                                        </p>
                                                    </div>
                                                    <div class="text-right">
                                                        <span class="block text-[10px] uppercase tracking-[1px] text-blue-400 font-semibold">BOARDING GATE</span>
                                                        <span class="text-4xl font-bold text-white">@(trip?.Airport_From.Name ?? "Borg El Arab")</span>
                                                    </div>
                                                </div>

                                                <!-- Progress -->
                                                <div class="mt-12">
                                                    <div class="flex justify-between text-xs uppercase tracking-widest text-slate-400 mb-3">
                                                        <span>Preparation Status</span>
                                                        <span>65% Complete</span>
                                                    </div>
                                                    <div class="h-2 bg-zinc-800 rounded-full overflow-hidden">
                                                        <div class="h-full bg-gradient-to-r from-blue-500 to-cyan-400 w-[65%] rounded-full"></div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="flex gap-6 mt-10">
                                                <a href="#" class="font-bold text-white flex items-center gap-2 hover:text-blue-400 transition-colors">
                                                    INITIATE CHECK-IN
                                                    <span class="material-symbols-outlined">arrow_forward</span>
                                                </a>
                                                <a href="#" class="text-slate-400 hover:text-white transition-colors">Manage Trip</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
                <div class="mb-32">
                    <div class="flex flex-col md:flex-row items-center justify-between gap-8 mb-16 text-center md:text-left">
                        <div class="space-y-2">
                            <p class="text-primary font-bold tracking-[0.3em] uppercase text-[10px]">Curated Experiences</p>
                            <h3 class="text-4xl font-800 text-white tracking-tight">New Destinations</h3>
                        </div>
                        <p class="text-slate-400 max-w-sm">Exclusive access to the world's most desired locales with signature SkyStream service.</p>
                    </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

                @if (Model.trips != null && Model.trips.Any())
                {
                    foreach (var trip in Model.trips)
                    {
                        <div class="group relative aspect-[3/4] overflow-hidden rounded-3xl cursor-pointer bg-slate-900 border border-white/5 hover:border-primary/40 transition-all duration-500">

                            <!-- Background -->
                            <div class="absolute inset-0 bg-cover bg-center transition-transform duration-[3s] group-hover:scale-110 opacity-70"
