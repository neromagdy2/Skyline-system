


@model Airport_Managment_SYS.Areas.Customer.ViewModels.SearchTripsVM

@{
    Layout = "_customer_layout";
    ViewData["Title"] = "Home";
}

<main class="flex-1">

    <!-- Hero Section -->
    <section class="relative w-full min-h-[600px] flex flex-col items-center justify-center px-4 py-20 bg-slate-900 overflow-hidden">
        <div class="absolute inset-0 z-0">
            <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/60 z-10"></div>
            <div class="w-full h-full bg-cover bg-center"
                 style='background-image: url("https://islamonline.net/wp-content/uploads/2022/06/Madinah-Mosque.jpg");'>
            </div>
        </div>

        <div class="relative z-20 w-full max-w-5xl mx-auto flex flex-col items-center gap-8">

            <div class="text-center space-y-4">
                <h1 class="text-white text-4xl md:text-6xl font-800 leading-tight tracking-tight">
                    Where to next?
                </h1>
                <p class="text-slate-100 text-lg md:text-xl font-medium max-w-2xl mx-auto">
                    Explore 500+ destinations with the world's most awarded airline.
                </p>
            </div>

            <!-- SEARCH FORM -->
            <div class="w-full bg-white/95 backdrop-blur-xl p-6 md:p-8 rounded-xl shadow-2xl border border-white/20">

                <form asp-area="Customer"
                      asp-controller="Home"
                      asp-action="SearchTrips"
                      method="get"
                      class="grid grid-cols-1 md:grid-cols-4 gap-4">

                    <!-- From -->
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">
                            From
                        </label>

                        <div class="border border-slate-200 rounded-lg bg-white h-14 px-4 flex items-center">
                            <span class="material-symbols-outlined text-slate-400 mr-2">
                                flight_takeoff
                            </span>

                            <select asp-for="DepartureCity"
                                    class="w-full bg-transparent border-none focus:ring-0 font-semibold">

                                <option value="">Select Departure</option>

                                @foreach (var state in Model.States!)
                                {
                                    <option value="@state.Id">
                                        @state.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <span asp-validation-for="DepartureCity"
                              class="text-red-500 text-sm"></span>
                    </div>

                    <!-- To -->
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">
                            To
                        </label>

                        <div class="border border-slate-200 rounded-lg bg-white h-14 px-4 flex items-center">
                            <span class="material-symbols-outlined text-slate-400 mr-2">
                                flight_land
                            </span>

                            <select asp-for="ArrivalCity"
                                    class="w-full bg-transparent border-none focus:ring-0 font-semibold">

                                <option value="">Select Destination</option>

                                @foreach (var state in Model.States!)
                                {
                                    <option value="@state.Id"
                                            selected="@(Model.ArrivalCity == state.Id)">
                                        @state.Name
                                    </option>
                                }

                            </select>
                        </div>

                        <span asp-validation-for="ArrivalCity"
                              class="text-red-500 text-sm"></span>
                    </div>

                    <!-- Date -->
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">
                            Departure Date
                        </label>
                        <div class="flex items-center border border-slate-200 rounded-lg bg-white h-14 px-4">
                            <span class="material-symbols-outlined text-slate-400 mr-2">
                                calendar_today
                            </span>
                            <input asp-for="DepartureTime"
                                   type="date"
                                   value="@DateTime.Now.ToString("dd-MM-yyyy")"
                                   class="w-full border-none bg-transparent p-0 font-semibold focus:ring-0" />
                        </div>
                        <span asp-validation-for="DepartureTime"
                              class="text-red-500 text-sm"></span>
                    </div>

                    <!-- Button -->
                    <div class="flex items-end">
                        <button type="submit"
                                class="w-full h-14 bg-primary text-white font-bold rounded-lg flex items-center justify-center gap-2 shadow-lg hover:opacity-90 transition">
                            <span class="material-symbols-outlined">search</span>
                            Search Flights
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </section>
    <section class="max-w-7xl mx-auto px-6 py-16">
        <div class="mb-20">
            <div class="flex items-center justify-between mb-8">
                <h3 class="text-2xl font-800 text-slate-900 dark:text-slate-100">Your Upcoming Trip</h3>
                <a class="text-primary font-bold text-sm hover:underline flex items-center gap-1" href="#">Manage All Bookings <span class="material-symbols-outlined text-lg">chevron_right</span></a>
            </div>
            <div class="max-w-xl mx-auto">
                <div class="group bg-white dark:bg-slate-800 rounded-2xl shadow-xl overflow-hidden border border-slate-100 dark:border-slate-700 hover:shadow-2xl transition-all">
                    <div class="relative h-56 overflow-hidden">
                        <div class="absolute inset-0 bg-cover bg-center group-hover:scale-105 transition-transform duration-700" data-alt="Eiffel Tower in Paris with bright blue sky" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuC9hnlQu4ud6hAa6rQQAu2Q5qCHjlNWJN72yQ8BXcQy1OoOuK-qmWtEp_QB1HPNJpdtpaOLJJNmpy_w3AcurGaIYpVOwRMlPSjdv4Fivai6vNcMfNvJe_cwVvhlYvq8mhNV1EtHr9SXPAux5_-Cv2tJJZaRHl1sp3OaDNCmYUvINYGs995tnDLuDZ2k2WmDyqUOVVjYkaKJlle78E76lkoWtMoiblUcTTfnHeOV6_pt_1_Pnub2x-yD5IQWFpsZ-hFfJOX4EJQQK4I");'></div>
                        <div class="absolute top-4 left-4 bg-white/95 dark:bg-slate-900/95 px-4 py-1.5 rounded-full text-xs font-extrabold text-primary shadow-sm uppercase tracking-wider">Confirmed Booking</div>
                    </div>
                    <div class="p-8">
                        <div class="flex justify-between items-start mb-6">
                            <div>
                                <h4 class="text-2xl font-800">Paris, France</h4>
                                <p class="text-slate-500 dark:text-slate-400 font-medium">Oct 24 - Oct 30, 2023</p>
                            </div>
                            <div class="text-right">
                                <span class="block text-xs font-bold text-primary uppercase tracking-tighter">Gate</span>
                                <span class="text-2xl font-bold">B12</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 mb-8">
                            <span class="text-xs font-bold text-slate-400 uppercase shrink-0">Progress</span>
                            <div class="flex-1 bg-slate-100 dark:bg-slate-700 rounded-full h-2.5">
                                <div class="bg-primary h-2.5 rounded-full w-2/3 shadow-sm shadow-primary/30"></div>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <button class="w-full py-3 rounded-xl bg-primary text-white text-sm font-bold hover:bg-primary/90 transition-all shadow-lg shadow-primary/20">
                                Check-in Now
                            </button>
                            <button class="w-full py-3 rounded-xl border-2 border-slate-100 dark:border-slate-700 text-sm font-bold hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
                                Trip Details
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="mb-20">
            <div class="text-center mb-12">
                <h3 class="text-3xl font-800 text-slate-900 dark:text-slate-100 mb-3">Explore Our Best Deals</h3>
                <p class="text-slate-500 dark:text-slate-400 max-w-xl mx-auto font-medium">Hand-picked destinations for your next escape with exclusive seasonal discounts.</p>
