


@model Airport_Managment_SYS.Areas.Customer.ViewModels.SearchTripsVM

@{
    Layout = "_customer_layout";
    ViewData["Title"] = "Home";
}


        <main class="flex-1">
    <section class="relative w-screen min-h-[750px] flex flex-col items-center justify-center pt-12 pb-32 overflow-hidden -mx-[50vw] left-[50%] right-[50%]">

        <!-- Background -->
        <div class="absolute inset-0 z-0">
            <div class="absolute inset-0 bg-gradient-to-b from-background-dark/80 via-transparent to-background-dark z-10"></div>

            <div class="absolute inset-0 bg-cover bg-center scale-110 blur-[2px] opacity-40"
                 style='background-image: url("https://islamonline.net/wp-content/uploads/2022/06/Madinah-Mosque.jpg");'>            </div>
        </div>

        <!-- Content -->
        <div class="relative z-20 w-full max-w-7xl mx-auto px-6 flex flex-col items-center gap-12">

            <!-- Title -->
            <div class="text-center space-y-6">

                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-primary/30 bg-primary/10 text-primary text-[10px] font-bold tracking-[0.2em] uppercase">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
                    </span>
                    Redefining Modern Travel
                </div>

                <h1 class="text-white text-5xl md:text-8xl font-800 leading-tight tracking-tighter glow-text">
                    The Distance is No Longer<br /><span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">The Limit</span>
                </h1>

                <p class="text-slate-400 text-lg dark__text-white md:text-xl max-w-3xl mx-auto">
                    Experience the pinnacle of aviation with SkyStream. Seamless booking meets futuristic comfort.
                </p>

            </div>

            <!-- Search Card -->
            <div  class="w-full
            bg-white/10
            backdrop-blur-xl
            p-6 md:p-8
            rounded-2xl
            shadow-2xl
            border border-white/20
            hover:bg-white/15
            transition">

                <form asp-area="Customer"
                      asp-controller="Home"
                      asp-action="SearchTrips"
                      method="get"
                      class="grid grid-cols-1 md:grid-cols-4 gap-4">

                    <!-- From -->
                    <div>
                        <label class="block text-xs font-bold text-slate-300 uppercase mb-1">
                            From
                        </label>

                        <div class="border border-white/20 rounded-lg bg-white/10 backdrop-blur-md h-14 px-4 flex items-center text-white focus-within:border-primary transition">

                            <span class="material-symbols-outlined text-slate-300 mr-2">
                                flight_takeoff
                            </span>

                            <select asp-for="DepartureCity"
                                    class="w-full bg-transparent border-none focus:ring-0 font-semibold text-white">

                                <option class="text-black" value="">Select Departure</option>

                                @foreach (var state in Model.States!)
                                {
                                    <option class="text-black" value="@state.Id">
                                        @state.Name
                                    </option>
                                }

                            </select>
                        </div>

                        <span asp-validation-for="DepartureCity"
                              class="text-red-400 text-sm"></span>
                    </div>

                    <!-- To -->
                    <div>
                        <label class="block text-xs font-bold text-slate-300 uppercase mb-1">
                            To
                        </label>

                        <div class="border border-white/20 rounded-lg bg-white/10 backdrop-blur-md h-14 px-4 flex items-center text-white focus-within:border-primary transition">

                            <span class="material-symbols-outlined text-slate-300 mr-2">
                                flight_land
                            </span>

                            <select asp-for="ArrivalCity"
                                    class="w-full bg-transparent border-none focus:ring-0 font-semibold text-white">

                                <option class="text-black" value="">Select Destination</option>

                                @foreach (var state in Model.States!)
                                {
                                    <option class="text-black"
                                            value="@state.Id"
                                            selected="@(Model.ArrivalCity == state.Id)">
                                        @state.Name
                                    </option>
                                }

                            </select>
                        </div>

                        <span asp-validation-for="ArrivalCity"
                              class="text-red-400 text-sm"></span>
                    </div>

                    <!-- Date -->
                    <div>
                        <label class="block text-xs font-bold text-slate-300 uppercase mb-1">
                            Departure Date
                        </label>

                        <div class="flex items-center border border-white/20 rounded-lg bg-white/10 backdrop-blur-md h-14 px-4 text-white focus-within:border-primary transition">

                            <span class="material-symbols-outlined text-slate-300 mr-2">
                                calendar_today
                            </span>

                            <input asp-for="DepartureTime"
                                   type="date"
                                   min="@DateTime.UtcNow"
                                   value="@DateTime.UtcNow.Date"
                                   class="w-full border-none bg-transparent p-0 font-semibold focus:ring-0" />
                                   class="w-full border-none bg-transparent p-0 font-semibold focus:ring-0 text-white" />

                        </div>

                        <span asp-validation-for="DepartureTime"
                              class="text-red-400 text-sm"></span>
                    </div>

                    <!-- Search Button -->
                    <div class="flex items-end">
                        <button type="submit"
                                class="w-full h-14 bg-primary text-white font-bold rounded-lg flex items-center justify-center gap-2 shadow-lg hover:opacity-90 transition">

                            <span class="material-symbols-outlined">
                                search
                            </span>

                            Search Flights

                        </button>
                    </div>

                </form>
            </div>
        </div>

