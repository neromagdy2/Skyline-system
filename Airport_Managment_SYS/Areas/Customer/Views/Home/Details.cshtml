@model Airport_Managment_SYS.Areas.Customer.ViewModels.DetailsTripVM

<section class="glass-card rounded-4 shadow-xl p-4 p-sm-5 my-5" style="max-width: 1024px; margin-left: auto; margin-right: auto;">
    <h2 class="display-6 fw-bold mb-5 text-center text-white" style="letter-spacing: -0.02em;">Trip Details</h2>

    <!-- Route & Schedule -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-md-6">
            <div class="d-flex flex-column gap-2">
                <p class="text-uppercase fw-bold text-white-50 mb-0" style="font-size: 0.625rem; letter-spacing: 0.2em;">Route</p>
                <p class="text-white mb-0">
                    <span class="fw-semibold text-amber">@Model.Trip?.Airport_From?.Name</span>
                    <span class="mx-2 text-white-50">→</span>
                    <span class="fw-semibold text-amber">@Model.Trip?.Airport_To?.Name</span>
                </p>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="d-flex flex-column gap-2">
                <p class="text-uppercase fw-bold text-white-50 mb-0" style="font-size: 0.625rem; letter-spacing: 0.2em;">Schedule & Price</p>
                <p class="text-white mb-1"><span class="fw-semibold text-white-50">Departure:</span> @((Model.Trip?.DateTime.ToString("f")) ?? "N/A")</p>
                <p class="text-white mb-1"><span class="fw-semibold text-white-50">Arrival:</span> @((Model.Trip?.ArrivalDateTime.ToString("f")) ?? "N/A")</p>
                <p class="text-white mb-0"><span class="fw-semibold text-white-50">Base price:</span> <span class="fs-4 fw-bold text-emerald">$@Model.Trip?.Price</span></p>
            </div>
        </div>
    </div>

    <!-- Available Seats Count -->
    <div class="mb-4">
        <p class="text-white mb-0"><span class="fw-semibold">Total available seats:</span> <span id="availableCount" class="fw-semibold">@Model.AvailableSeats</span></p>
    </div>

    <div class="row g-4">
        <!-- Left Column: Controls -->
        <div class="col-12 col-lg-4">
            <div class="d-flex flex-column gap-4">
                <!-- Seat Class Select -->
                <div>
                    <label for="seatClassSelect" class="form-label fw-medium text-white mb-1" style="font-size: 0.875rem;">Select seat class</label>
                    <select id="seatClassSelect" name="SelectedSeatClassId" class="form-select-dark w-100">
                        <option value="0" data-mult="0" data-avail="0">-- Choose class --</option>
                        @if (Model.SeatClasses != null)
                        {
                            foreach (var sc in Model.SeatClasses)
                            {
                                var avail = Model.AvailableByClass?.ContainsKey(sc.Id) == true ? Model.AvailableByClass[sc.Id] : 0;
                                <option value="@sc.Id" data-mult="@sc.PriceMult" data-avail="@avail">
                                    @sc.Name (@avail available)
                                </option>
                            }
                        }
                    </select>
                </div>

                <!-- Per Seat Price -->
                <div>
                    <p class="text-white mb-0"><span class="fw-semibold">Per-seat price:</span> <span id="perSeatPrice" class="fs-4 fw-bold text-emerald">-</span></p>
                </div>

                <!-- Legend -->
                <div class="d-flex flex-column gap-2">
                    <p class="text-uppercase fw-bold text-white-50 mb-0" style="font-size: 0.625rem; letter-spacing: 0.2em;">Legend</p>
                    <div class="d-flex align-items-center gap-2">
                        <span class="d-inline-block rounded" style="width: 20px; height: 20px; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255,255,255,0.2);"></span>
                        <span class="text-white small">Available seat</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="d-inline-block rounded" style="width: 20px; height: 20px; background: rgba(71, 85, 105, 0.6); border: 1px solid rgba(255,255,255,0.2); opacity: 0.6;"></span>
                        <span class="text-white small">Booked seat</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="d-inline-block rounded" style="width: 20px; height: 20px; background: var(--bs-primary); border: 1px solid var(--bs-primary); box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.4);"></span>
                        <span class="text-white small">Selected seat</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Seat Map & Form -->
        <div class="col-12 col-lg-8">
            <div class="d-flex flex-column gap-4">
                <!-- Seat Map Header -->
                <div class="d-flex align-items-center justify-content-between">
                    <span class="fw-semibold text-white" style="font-size: 0.875rem;">Seat map</span>
                </div>

                <!-- Seat Grid -->
                <div id="seatGrid">
                    @{
                        var tripSeats = Model.Trip?.TripSeats?
                            .Where(ts => ts.Seat != null)
                            .OrderBy(ts => ts.Seat.SeatNumber)
                            .ToList() ?? new List<Airport_Managment_SYS.Models.TripSeat>();
                        int perRow = 6;
                        var groupedByClass = tripSeats
                            .GroupBy(ts => new
                            {
                                ClassId = ts.Seat?.seatClassId ?? 0,
                                ClassName = ts.Seat?.SeatClass?.Name ?? "Uncategorized"
                            })
                            .OrderBy(g => g.Key.ClassId)
                            .ToList();
                    }
                    @if (groupedByClass.Any())
                    {
                        foreach (var group in groupedByClass)
                        {
                            <div class="mb-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="fw-semibold text-white-50 text-uppercase" style="font-size: 0.625rem; letter-spacing: 0.1em;">@group.Key.ClassName</span>
                                    <span class="text-white-50 small">@group.Count(ts => !ts.IsBooked) available</span>
                                </div>
                                @for (int i = 0; i < group.Count(); i += perRow)
                                {
                                    <div class="d-flex flex-wrap gap-2 mb-2">
                                        @foreach (var ts in group.Skip(i).Take(perRow))
                                        {
                                            var seat = ts.Seat;
                                            var seatClassId = seat?.seatClassId ?? 0;
                                            var isBooked = ts.IsBooked;
                                            var btnClass = isBooked ? "seat-booked" : "seat-available";
                                            <button type="button"
                                                    class="seat-button @btnClass"
                                                    data-seat-id="@seat?.Id"
                                                    data-seat-class-id="@seatClassId"
                                                    data-booked="@(isBooked.ToString().ToLower())">
                                                @seat?.SeatNumber
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-white-50 small">Seat map not available for this trip.</p>
                    }
                </div>

                <!-- Notifications -->
                @if (TempData["Success"] != null)
                {
                    <div class="bg-emerald-soft rounded-3 p-3 small">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="bg-red-soft rounded-3 p-3 small">@TempData["Error"]</div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div class="bg-amber-soft rounded-3 p-3 small">@TempData["Warning"]</div>
                }

                <!-- Reservation Form -->
                <form asp-controller="Home" asp-action="Reserve" method="post" id="reserveForm" class="d-flex flex-column gap-3">
                    <input type="hidden" name="TripId" value="@Model.Trip?.Id" />
                    <input type="hidden" id="seatClassHidden" name="SeatClassId" value="0" />
                    <input type="hidden" id="totalPriceHidden" name="TotalPrice" value="0" />
                    <div id="seatIdsContainer"></div>

                    <div id="seatCountContainer" class="d-none">
                        <p class="text-white mb-0">
                            <span class="fw-semibold">Seats selected:</span>
                            <span id="seatCountDisplay" class="fw-semibold"></span>
                        </p>
                    </div>

                    <div>
                        <p class="text-white mb-0"><span class="fw-semibold">Total price:</span> <span id="totalPrice" class="fs-2 fw-bold text-emerald">$0.00</span></p>
                    </div>

                    <button type="submit" id="reserveBtn" disabled class="btn btn-primary w-100 fw-bold py-3 rounded-3 glow-primary" style="font-size: 0.875rem;">
                        Reserve seats
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const select = document.getElementById('seatClassSelect');
            const seatClassHidden = document.getElementById('seatClassHidden');
            const perSeatPriceElem = document.getElementById('perSeatPrice');
            const totalPriceElem = document.getElementById('totalPrice');
            const totalPriceHidden = document.getElementById('totalPriceHidden');
            const reserveBtn = document.getElementById('reserveBtn');
            const seatButtons = Array.from(document.querySelectorAll('.seat-button'));
            const seatCountContainer = document.getElementById('seatCountContainer');
            const seatCountDisplay = document.getElementById('seatCountDisplay');

            const basePrice = parseFloat("@(Model.Trip?.Price ?? 0)");

            function clearSeatSelection() {
                seatButtons.forEach(btn => {
                    btn.removeAttribute('data-selected');
                    if (btn.dataset.booked === 'true') return;
                    btn.classList.remove('seat-selected');
                });
            }

            function syncSeatIdsFromSelection() {
                const selected = seatButtons.filter(b => b.dataset.selected === 'true');
                const seatIds = selected.map(b => b.dataset.seatId);
                const count = selected.length;

                const container = document.getElementById('seatIdsContainer');
                container.innerHTML = '';

                seatIds.forEach(seatId => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'SeatIds';
                    input.value = seatId;
                    container.appendChild(input);
                });

                if (count > 0) {
                    seatCountDisplay.textContent = count.toString();
                    seatCountContainer.classList.remove('d-none');
                } else {
                    seatCountDisplay.textContent = '';
                    seatCountContainer.classList.add('d-none');
                }

                return count;
            }

            function updatePrice() {
                const opt = select.options[select.selectedIndex] || select.options[0];
                const mult = parseFloat(opt.dataset.mult || '0') || 1;
                let per = basePrice * mult;

                const container = document.getElementById('seatIdsContainer');
                const count = container.querySelectorAll('input[name="SeatIds"]').length;

                if (parseInt(select.value || '0') === 0 || count === 0) {
                    reserveBtn.disabled = true;
                    perSeatPriceElem.textContent = '-';
                    totalPriceElem.textContent = '$0.00';
                    totalPriceHidden.value = '0';
                    seatClassHidden.value = '0';
                    return;
                }

                reserveBtn.disabled = false;
                perSeatPriceElem.textContent = '$' + per.toFixed(2);
                const total = per * count;
                totalPriceElem.textContent = '$' + total.toFixed(2);

                seatClassHidden.value = select.value;
                totalPriceHidden.value = total.toFixed(2);
            }

            seatButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    if (btn.dataset.booked === 'true') return;

                    const seatClassId = btn.dataset.seatClassId || '0';

                    if (!select.value || select.value === '0') {
                        const optionToSelect = Array.from(select.options).find(o => o.value === seatClassId);
                        if (optionToSelect) {
                            select.value = seatClassId;
                        }
                    }

                    if (select.value !== seatClassId) {
                        clearSeatSelection();
                        const optionToSelect = Array.from(select.options).find(o => o.value === seatClassId);
                        if (optionToSelect) {
                            select.value = seatClassId;
                        }
                    }

                    const currentlySelected = btn.dataset.selected === 'true';
                    if (currentlySelected) {
                        btn.removeAttribute('data-selected');
                        btn.classList.remove('seat-selected');
                    } else {
                        btn.dataset.selected = 'true';
                        btn.classList.add('seat-selected');
                    }

                    syncSeatIdsFromSelection();
                    updatePrice();
                });
            });

            select.addEventListener('change', () => {
                clearSeatSelection();
                syncSeatIdsFromSelection();
                updatePrice();
            });

            syncSeatIdsFromSelection();
            updatePrice();
        });
    </script>
}
