@model Airport_Managment_SYS.Areas.Customer.ViewModels.DetailsTripVM

<section class="max-w-4xl mx-auto p-6 bg-white dark:bg-slate-800 rounded-2xl shadow-lg">
    <h2 class="text-3xl font-bold mb-6 text-center">Trip Details</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div>
            <p><strong>From:</strong> <span class="text-primary">@(Model.Trip.Airport_From?.Name ?? "(unknown)")</span></p>
            <p><strong>To:</strong> <span class="text-primary">@(Model.Trip.Airport_To?.Name ?? "(unknown)")</span></p>
        </div>
        <div>
            <p><strong>Departure:</strong> @Model.Trip.DateTime.ToString("f")</p>
            <p><strong>Price:</strong> <span class="text-xl font-bold text-green-600">$@Model.Trip.Price</span></p>
        </div>
    </div>
    <div class="mb-4">
        <p><strong>Available seats:</strong> <span id="availableCount" class="font-semibold">@Model.AvailableSeats</span></p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 p-3 bg-green-100 text-green-800 rounded">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 p-3 bg-red-100 text-red-800 rounded">
            @TempData["Error"]
        </div>
    }

    <form asp-controller="Home" asp-action="Reserve" method="post" id="reserveForm" class="space-y-4">
        <input type="hidden" name="TripId" value="@Model.Trip.Id" />
        <div class="mb-4">
            <label for="seatCount" class="block font-medium">Number of seats</label>
            <input type="number" id="seatCount" name="SeatsToReserve" value="1" min="1" max="@Model.AvailableSeats" class="border p-2 rounded" />
        </div>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded">Reserve</button>
    </form>
</section>

@section Scripts {
    <script>
        (function() {
            const available = @Model.AvailableSeats;
            const input = document.getElementById('seatCount');
            input.addEventListener('input', function() {
                const val = parseInt(this.value, 10) || 0;
                if (val > available) {
                    this.value = available;
                } else if (val < 1) {
                    this.value = 1;
                }
            });
        })();
    </script>
}
