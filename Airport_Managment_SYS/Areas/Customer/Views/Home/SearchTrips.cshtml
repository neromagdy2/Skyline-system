@model Airport_Managment_SYS.Areas.Customer.ViewModels.SearchTripsVM
<body class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 antialiased">
    <div class="relative flex min-h-screen w-full flex-col">
        <main class="flex-1">
            <section class="bg-slate-900 px-6 py-8 lg:px-20">
                <div class="max-w-7xl mx-auto">

                    <form asp-action="SearchTrips" method="get"
                          class="flex flex-col md:flex-row items-center justify-between bg-white/10 backdrop-blur-md p-4 rounded-2xl  gap-4">

                        <div class="flex flex-col md:flex-row items-center gap-6 w-full">

                            <!-- From -->
                            <div class="flex flex-col w-full md:w-52">
                                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">
                                    From
                                </span>
                                <select name="DepartureCity"
                                        class="bg-transparent text-white font-bold border border-white/20 rounded-lg p-2">

                                    <option value="">Select Departure</option>

                                    @for (int i = 0; i < Model.States.Count(); i++)
                                    {
                                        var state = Model.States.ElementAt(i);

                                        <option value="@state.Id"
                                                selected="@(Model.DepartureCity == state.Id)">
                                            @state.Name
                                        </option>
                                    }
                                </select>
                            </div>

                            <!-- To -->
                            <div class="flex flex-col w-full md:w-52">
                                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">
                                    To
                                </span>
                                <select name="ArrivalCity"
                                        class="bg-transparent text-white font-bold border border-white/20 rounded-lg p-2">

                                    <option value="">Select Arrival</option>

                                    @for (int i = 0; i < Model.States.Count(); i++)
                                    {
                                        var state = Model.States.ElementAt(i);

                                        <option value="@state.Id"
                                                selected="@(Model.ArrivalCity == state.Id)">
                                            @state.Name
                                        </option>
                                    }
                                </select>
                            </div>

                            <!-- Date -->
                            <div class="flex flex-col w-full md:w-52">
                                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">
                                    Date
                                </span>
                                <input asp-for="DepartureTime"
                                       type="date"
                                       class="bg-transparent text-white font-bold border border-white/20 rounded-lg p-2" />
                            </div>

                        </div>

                        <button type="submit"
                                class="px-6 py-2 bg-white text-slate-900 rounded-lg text-sm font-bold hover:bg-slate-100 transition-colors">
                            Search
                        </button>

                    </form>

                </div>
            </section>
            <div class="max-w-7xl mx-auto px-6 py-10 lg:px-20">
                <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
                    <aside class="space-y-6">
                        <div class="bg-white/5 backdrop-blur-xl p-6 rounded-3xl  shadow-xl">

                            <h4 class="text-sm font-bold uppercase tracking-widest mb-6 text-slate-300">
                                Filters
                            </h4>

                            <form asp-action="SearchTrips" method="get">

                                <!-- نخلي البحث الأساسي محفوظ -->
                                <input type="hidden" name="DepartureCity" value="@Model.DepartureCity" />
                                <input type="hidden" name="ArrivalCity" value="@Model.ArrivalCity" />
                                <input type="hidden" name="DepartureTime" value="@Model.DepartureTime" />

                                <!-- Seat Class -->
                                <div class="mb-8">

                                    <label class="block text-xs font-bold text-slate-400 uppercase mb-3">
                                        Seat Class
                                    </label>

                                    @foreach (var seatClass in Model.seatClasses ?? Enumerable.Empty<SeatClass>())
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="SeatClassIds"
                                                   value="@seatClass.Id"
                                                   @(Model.SeatClassIds != null && Model.SeatClassIds.Contains(seatClass.Id) ? "checked" : "")>

                                            <label class="form-check-label">
                                                @seatClass.Name
                                            </label>
                                        </div>
                                    }

                                </div>


                                <!-- Max Price -->
                                <div class="mb-8">

                                    <label class="block text-xs font-bold text-slate-400 uppercase mb-3">
                                        Max Price
                                    </label>

                                    <input name="MaxPrice"
                                           type="range"
                                           min="50"
                                           max="2000"
                                           value="@Model.MaxPrice"
                                           step="50"
                                           class="mb-3  w-full h-1.5 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-primary" />
                                    <span id="priceValue">$@Model.MaxPrice</span>
                                </div>


                                <button type="submit"
                                        class="w-full bg-primary text-white font-bold py-3 rounded-xl hover:opacity-90 transition">
                                    Apply Filters
                                </button>

                            </form>

                        </div>
                    </aside>
                    <div class="lg:col-span-3 space-y-4">
                        @if (Model.trips != null && Model.trips.Any())
                        {
                            foreach (var trip in Model.trips)
                            {
                                <div class="bg-white/10 backdrop-blur-xl p-6 rounded-3xl shadow-xl border border-white/20 hover:border-primary/40 transition-all duration-300 flight-card-hover">

                                    <div class="flex flex-col md:flex-row items-center gap-8">

                                        <!-- Airline -->
                                        <div class="flex items-center gap-4 shrink-0">

                                            <div class="size-12 bg-primary/20 rounded-xl flex items-center justify-center">
                                                <span class="material-symbols-outlined text-primary">
                                                    rocket_launch
                                                </span>
                                            </div>

                                            <div class="flex flex-col text-white">
                                                <span class="font-bold text-sm">
                                                    @trip.Airplane?.Name
                                                </span>

                                                <span class="text-xs text-slate-400 font-medium">
                                                    @trip.Id
                                                </span>
                                            </div>

                                        </div>

                                        <!-- Flight Data -->
                                        <div class="flex-1 flex items-center justify-between w-full">

                                            <!-- Departure -->
                                            <div class="text-center md:text-left text-white">

                                                <span class="block text-xl font-bold">
                                                    @trip.DateTime.ToString("hh:mm tt")
                                                </span>

                                                <span class="text-xs font-bold text-slate-400 uppercase">
                                                    @trip.Airport_From.GovernerateState.Name
                                                </span>

                                            </div>

                                            <!-- Flight Path -->
                                            <div class="flex-1 px-8 flex flex-col items-center">

                                                <span class="text-xs font-bold text-slate-400 mb-1">
                                                    3 hours
                                                </span>

                                                <div class="relative w-full h-px bg-white/20 flex items-center justify-center">

                                                    <span class="material-symbols-outlined text-primary text-sm bg-slate-900 px-2 absolute rounded-full">
                                                        flight
                                                    </span>

                                                </div>

                                                <span class="text-xs font-bold text-primary mt-1">
                                                    Non-stop
                                                </span>

                                            </div>

                                            <!-- Arrival -->
                                            <div class="text-center md:text-right text-white">

                                                <span class="block text-xl font-bold">
                                                    @trip.ArrivalDateTime.ToString("hh:mm tt")
                                                </span>

                                                <span class="text-xs font-bold text-slate-400 uppercase">
                                                    @trip.Airport_To.GovernerateState.Name
                                                </span>

                                            </div>

                                        </div>

                                        <!-- Price -->
                                        <div class="flex flex-col items-center md:items-end gap-2 shrink-0 border-t md:border-t-0 md:border-l border-white/20 pt-4 md:pt-0 md:pl-8 w-full md:w-auto">

                                            <span class="text-2xl font-bold text-primary">
                                                $@trip.Price
                                            </span>

                                            <a asp-action="Details"
                                               asp-route-id="@trip.Id"
                                               class="bg-primary text-white px-6 py-2.5 rounded-xl text-sm font-bold shadow-lg shadow-primary/30 hover:bg-primary/90 transition-all w-full md:w-auto text-center">

                                                Select Flight

                                            </a>

                                        </div>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                                <div class="text-center text-gray-400 py-10">
                                No flights found.
                            </div>
                        }

                        <!-- Pagination Controls -->
                        @{
                            var departureDateStr = Model.DepartureTime != default ? Model.DepartureTime.ToString("yyyy-MM-dd") : "";
                        }
                        @if (Model.TotalPages > 1)
                        {
                            <div class="flex justify-center items-center mt-8 space-x-2">
                                @if (Model.CurrentPage > 1)
                                {
                                    <a asp-action="SearchTrips"
                                       asp-route-page="@(Model.CurrentPage - 1)"
                                       asp-route-DepartureCity="@Model.DepartureCity"
                                       asp-route-ArrivalCity="@Model.ArrivalCity"
                                       asp-route-DepartureTime="@departureDateStr"
                                       asp-route-MaxPrice="@Model.MaxPrice"
                                       class="px-4 py-2 border border-white/20 bg-white/5 hover:bg-white/10 text-white rounded-lg transition-colors">
                                        Previous
                                    </a>
                                }

                                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                {
                                    var isActive = i == Model.CurrentPage;
                                    var pageClass = isActive
                                        ? "px-4 py-2 border bg-primary border-primary text-white font-bold rounded-lg transition-colors"
                                        : "px-4 py-2 border border-white/20 bg-white/5 hover:bg-white/10 text-white rounded-lg transition-colors";
                                    <a asp-action="SearchTrips"
                                       asp-route-page="@i"
                                       asp-route-DepartureCity="@Model.DepartureCity"
                                       asp-route-ArrivalCity="@Model.ArrivalCity"
                                       asp-route-DepartureTime="@departureDateStr"
                                       asp-route-MaxPrice="@Model.MaxPrice"
                                       class="@pageClass">
                                        @i
                                    </a>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <a asp-action="SearchTrips"
                                       asp-route-page="@(Model.CurrentPage + 1)"
                                       asp-route-DepartureCity="@Model.DepartureCity"
                                       asp-route-ArrivalCity="@Model.ArrivalCity"
                                       asp-route-DepartureTime="@departureDateStr"
                                       asp-route-MaxPrice="@Model.MaxPrice"
                                       class="px-4 py-2 border border-white/20 bg-white/5 hover:bg-white/10 text-white rounded-lg transition-colors">
                                        Next
                                    </a>
                                }
                            </div>
                            <div class="text-center mt-3 text-sm text-slate-400">
                                Showing flights @(((Model.CurrentPage - 1) * Model.PageSize) + 1) to @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems) of @Model.TotalItems
                            </div>
                        }

                    </div>
                </div>
            </div>
        </main>
    </div>
    <script>
        const range = document.querySelector("input[name='MaxPrice']");
        const price = document.getElementById("priceValue");

        range.addEventListener("input", () => {
            price.innerText = "$" + range.value;
        });</script>
</body>

<style>
    .flight-card-hover:hover {
        transform: translateY(-4px);
    }</style>