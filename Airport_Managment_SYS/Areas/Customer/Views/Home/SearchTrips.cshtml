@model Airport_Managment_SYS.Areas.Customer.ViewModels.SearchTripsVM
<body class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 antialiased">
    <div class="relative flex min-h-screen w-full flex-col">
        <main class="flex-1">
            <section class="bg-slate-900 px-6 py-8 lg:px-20">
                <div class="max-w-7xl mx-auto">

                    <form asp-action="SearchTrips" method="get"
                          class="flex flex-col md:flex-row items-center justify-between bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/10 gap-4">

                        <div class="flex flex-col md:flex-row items-center gap-6 w-full">

                            <!-- From -->
                            <div class="flex flex-col w-full md:w-52">
                                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">
                                    From
                                </span>
                                <select name="DepartureCity"
                                        class="bg-transparent text-white font-bold border border-white/20 rounded-lg p-2">

                                    <option value="">Select Departure</option>

                                    @for (int i = 0; i < Model.States.Count(); i++)
                                    {
                                        var state = Model.States.ElementAt(i);

                                        <option value="@state.Id"
                                                selected="@(Model.DepartureCity == state.Id)">
                                            @state.Name
                                        </option>
                                    }
                                </select>
                            </div>

                            <!-- To -->
                            <div class="flex flex-col w-full md:w-52">
                                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">
                                    To
                                </span>
                                <select name="ArrivalCity"
                                        class="bg-transparent text-white font-bold border border-white/20 rounded-lg p-2">

                                    <option value="">Select Arrival</option>

                                    @for (int i = 0; i < Model.States.Count(); i++)
                                    {
                                        var state = Model.States.ElementAt(i);

                                        <option value="@state.Id"
                                                selected="@(Model.ArrivalCity == state.Id)">
                                            @state.Name
                                        </option>
                                    }
                                </select>
                            </div>

                            <!-- Date -->
                            <div class="flex flex-col w-full md:w-52">
                                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">
                                    Date
                                </span>
                                <input asp-for="DepartureTime"
                                       type="date"
                                       class="bg-transparent text-white font-bold border border-white/20 rounded-lg p-2" />
                            </div>

                        </div>

                        <button type="submit"
                                class="px-6 py-2 bg-white text-slate-900 rounded-lg text-sm font-bold hover:bg-slate-100 transition-colors">
                            Search
                        </button>

                    </form>

                </div>
            </section>
            <div class="max-w-7xl mx-auto px-6 py-10 lg:px-20">
                <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
                    <aside class="space-y-6">
                        <div class="bg-white dark:bg-slate-800 p-6 rounded-3xl shadow-sm border border-slate-100 dark:border-slate-700">
                            <h4 class="text-sm font-800 uppercase tracking-widest mb-6">Filters</h4>
                    
                            <div class="mb-8">
                                <label class="block text-xs font-bold text-slate-400 uppercase mb-3">Departure Time</label>
                                <div class="grid grid-cols-2 gap-2">
                                    <button class="px-2 py-2 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-bold hover:border-primary transition-colors">Morning</button>
                                    <button class="px-2 py-2 border border-primary bg-primary/5 rounded-lg text-xs font-bold text-primary">Afternoon</button>
                                    <button class="px-2 py-2 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-bold hover:border-primary transition-colors">Evening</button>
                                    <button class="px-2 py-2 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-bold hover:border-primary transition-colors">Night</button>
                                </div>
                            </div>
                            <div class="mb-8">
                                <label class="block text-xs font-bold text-slate-400 uppercase mb-3">Price Range</label>
                                <input class="w-full h-1.5 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-primary" type="range" />
                                <div class="flex justify-between mt-2 text-xs font-bold">
                                    <span>$150</span>
                                    <span>$1,200</span>
                                </div>
                            </div>
                          
                        </div>
                    </aside>
                    <div class="lg:col-span-3 space-y-4">
                        @if (Model.trips != null && Model.trips.Any())
                        {
                            foreach (var trip in Model.trips)
                            {
                                <div class="bg-white dark:bg-slate-800 p-6 rounded-3xl shadow-sm border border-slate-100 dark:border-slate-700 flight-card-hover">
                                    <div class="flex flex-col md:flex-row items-center gap-8">

                                        <div class="flex items-center gap-4 shrink-0">
                                            <div class="size-12 bg-primary/10 rounded-xl flex items-center justify-center">
                                                <span class="material-symbols-outlined text-primary">rocket_launch</span>
                                            </div>
                                            <div class="flex flex-col">
                                                <span class="font-bold text-sm">
                                                    @trip.Airplane?.Name
                                                </span>
                                                <span class="text-xs text-slate-400 font-medium">
                                                    @trip.Id
                                                </span>
                                            </div>
                                        </div>

                                        <div class="flex-1 flex items-center justify-between w-full">
                                            <div class="text-center md:text-left">
                                                <span class="block text-xl font-800">
                                                    @trip.DateTime.ToString("hh:mm tt")
                                                </span>
                                                <span class="text-xs font-bold text-slate-400 uppercase">
                                                    @trip.Airport_From.GovernerateState.Name
                                                </span>
                                            </div>

                                            <div class="flex-1 px-8 flex flex-col items-center">
                                                <span class="text-xs font-bold text-slate-400 mb-1">
                                                    3 hours
                                                </span>
                                                <div class="relative w-full h-px bg-slate-200 dark:bg-slate-700 flex items-center justify-center">
                                                    <span class="material-symbols-outlined text-primary text-sm bg-white dark:bg-slate-800 px-2 absolute">
                                                        flight
                                                    </span>
                                                </div>
                                                <span class="text-xs font-bold text-primary mt-1">
                                                    Non-stop
                                                </span>
                                            </div>

                                            <div class="text-center md:text-right">
                                                <span class="block text-xl font-800">
                                                    @trip.DateTime.ToString("hh:mm tt")
                                                </span>
                                                <span class="text-xs font-bold text-slate-400 uppercase">
                                                    @trip.Airport_To.GovernerateState.Name
                                                </span>
                                            </div>
                                        </div>

                                        <div class="flex flex-col items-center md:items-end gap-2 shrink-0 border-t md:border-t-0 md:border-l border-slate-100 dark:border-slate-700 pt-4 md:pt-0 md:pl-8 w-full md:w-auto">
                                            <span class="text-2xl font-800 text-primary">
                                                $@trip.Price
                                            </span>
                                            <a asp-action="Details" asp-route-id="@trip.Id"
                                               class="bg-primary text-white px-6 py-2.5 rounded-xl text-sm font-bold shadow-lg shadow-primary/20 hover:bg-primary/90 transition-all w-full md:w-auto text-center">
                                                Select Flight
                                            </a>
                                        </div>

                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-gray-400 py-10">
                                No flights found.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </main>
    </div>

</body>
