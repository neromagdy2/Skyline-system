@model Airport_Managment_SYS.Areas.Customer.ViewModels.HomeVM

<!-- Search Bar Section -->
<section class="search-bar-section py-4">
    <div class="container-fluid px-4 px-lg-5" style="max-width: 1400px; margin: 0 auto;">
        <form asp-action="SearchTrips" method="get"
              class="glass-card rounded-3 p-3 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">

            <div class="d-flex flex-column flex-md-row align-items-center gap-3 w-100">

                <!-- From -->
                <div class="d-flex flex-column w-100" style="max-width: 220px;">
                    <span class="text-uppercase fw-bold text-white-50 mb-1" style="font-size: 0.625rem; letter-spacing: 0.1em;">From</span>
                    <select asp-for="SearchTripsVM.DepartureCity"
                            class="form-select-dark w-100 fw-bold">
                        <option value="">Select Departure</option>
                        @for (int i = 0; i < Model.SearchTripsVM.States.Count(); i++)
                        {
                            var state = Model.SearchTripsVM.States.ElementAt(i);
                            <option value="@state.Id"
                                    selected="@(Model.SearchTripsVM.DepartureCity == state.Id)">
                                @state.Name
                            </option>
                        }
                    </select>
                </div>

                <!-- To -->
                <div class="d-flex flex-column w-100" style="max-width: 220px;">
                    <span class="text-uppercase fw-bold text-white-50 mb-1" style="font-size: 0.625rem; letter-spacing: 0.1em;">To</span>
                    <select asp-for="SearchTripsVM.ArrivalCity"
                            class="form-select-dark w-100 fw-bold">
                        <option value="">Select Arrival</option>
                        @for (int i = 0; i < Model.SearchTripsVM.States.Count(); i++)
                        {
                            var state = Model.SearchTripsVM.States.ElementAt(i);
                            <option value="@state.Id"
                                    selected="@(Model.SearchTripsVM.ArrivalCity == state.Id)">
                                @state.Name
                            </option>
                        }
                    </select>
                </div>

                <!-- Date -->
                <div class="d-flex flex-column w-100" style="max-width: 220px;">
                    <span class="text-uppercase fw-bold text-white-50 mb-1" style="font-size: 0.625rem; letter-spacing: 0.1em;">Date</span>
                    <input asp-for="SearchTripsVM.DepartureTime"
                           type="date"
                           class="form-select-dark w-100 fw-bold" />
                </div>

            </div>

            <button type="submit"
                    class="btn btn-light fw-bold px-4 py-2 rounded-3 text-dark"
                    style="font-size: 0.875rem;">
                Search
            </button>

        </form>
    </div>
</section>

<!-- Results Section -->
<div class="container-fluid px-4 px-lg-5 py-5" style="max-width: 1400px; margin: 0 auto;">
    <div class="row g-4">
        <!-- Sidebar Filters -->
        <aside class="col-12 col-lg-3">
            <div class="glass-card rounded-4 p-4 shadow-xl">

                <h4 class="text-uppercase fw-bold mb-4 text-white-50" style="font-size: 0.75rem; letter-spacing: 0.2em;">Filters</h4>

                <form asp-action="SearchTrips" method="get">

                    <!-- Hidden search params -->
                    <input type="hidden" asp-for="SearchTripsVM.DepartureCity" />
                    <input type="hidden" asp-for="SearchTripsVM.ArrivalCity" />
                    <input type="hidden" asp-for="SearchTripsVM.DepartureTime" />

                    <!-- Seat Class -->
                    <div class="mb-4">
                        <label class="text-uppercase fw-bold text-white-50 mb-3 d-block" style="font-size: 0.625rem; letter-spacing: 0.1em;">Seat Class</label>

                        @foreach (var seatClass in Model.SearchTripsVM.seatClasses ?? Enumerable.Empty<SeatClass>())
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input form-check-input-dark"
                                       type="checkbox"
                                       name="SearchTripsVM.SeatClassIds"
                                       value="@seatClass.Id"
                                @(Model.SearchTripsVM.SeatClassIds != null && Model.SearchTripsVM.SeatClassIds.Contains(seatClass.Id) ? "checked" : "")>
                                <label class="form-check-label form-check-label-dark">@seatClass.Name</label>
                            </div>
                        }
                    </div>

                    <!-- Max Price -->
                    <div class="mb-4">
                        <label class="text-uppercase fw-bold text-white-50 mb-3 d-block" style="font-size: 0.625rem; letter-spacing: 0.1em;">Max Price</label>

                        <input asp-for="SearchTripsVM.MaxPrice"
                               type="range"
                               min="50"
                               max="2000"
                               step="50"
                               class="range-slider mb-2" />
                        <span id="priceValue" class="text-white fw-bold">$@Model.SearchTripsVM.MaxPrice</span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100 fw-bold py-3 rounded-3">
                        Apply Filters
                    </button>

                </form>

            </div>
        </aside>

        <!-- Flight Results -->
        <div class="col-12 col-lg-9">
            <div class="d-flex flex-column gap-3">
                @if (Model.SearchTripsVM.trips != null && Model.SearchTripsVM.trips.Any())
                {
                    foreach (var trip in Model.SearchTripsVM.trips)
                    {
                        <div class="glass-card rounded-4 p-4 shadow-xl border border-white border-opacity-10 flight-card-hover">

                            <div class="d-flex flex-column flex-md-row align-items-center gap-4">

                                <!-- Airline -->
                                <div class="d-flex align-items-center gap-3 flex-shrink-0">
                                    <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px; background: rgba(59, 130, 246, 0.2);">
                                        <i class="bi bi-rocket-takeoff text-primary fs-4"></i>
                                    </div>
                                    <div class="d-flex flex-column text-white">
                                        <span class="fw-bold" style="font-size: 0.875rem;">@trip.Airplane?.Name</span>
                                        <span class="text-white-50" style="font-size: 0.75rem;">@trip.Id</span>
                                    </div>
                                </div>

                                <!-- Flight Data -->
                                <div class="flex-grow-1 d-flex align-items-center justify-content-between w-100">

                                    <!-- Departure -->
                                    <div class="text-center text-md-start text-white">
                                        <span class="d-block fs-4 fw-bold">@trip.DateTime.ToString("hh:mm tt")</span>
                                        <span class="text-uppercase fw-bold text-white-50" style="font-size: 0.625rem; letter-spacing: 0.1em;">@trip.Airport_From.GovernerateState.Name</span>
                                    </div>

                                    <!-- Flight Path -->
                                    <div class="flex-grow-1 px-3 px-md-4 d-flex flex-column align-items-center">
                                        <span class="text-white-50" style="font-size: 0.625rem; font-weight: 700;">3 hours</span>
                                        <div class="flight-path-line my-1">
                                            <span class="flight-path-icon">
                                                <i class="bi bi-airplane-fill text-primary" style="font-size: 0.75rem;"></i>
                                            </span>
                                        </div>
                                        <span class="text-primary" style="font-size: 0.625rem; font-weight: 700;">Non-stop</span>
                                    </div>

                                    <!-- Arrival -->
                                    <div class="text-center text-md-end text-white">
                                        <span class="d-block fs-4 fw-bold">@trip.ArrivalDateTime.ToString("hh:mm tt")</span>
                                        <span class="text-uppercase fw-bold text-white-50" style="font-size: 0.625rem; letter-spacing: 0.1em;">@trip.Airport_To.GovernerateState.Name</span>
                                    </div>

                                </div>

                                <!-- Price -->
                                <div class="d-flex flex-column align-items-center align-items-md-end gap-2 flex-shrink-0 border-top border-md-top-0 border-md-start border-white border-opacity-10 pt-3 pt-md-0 ps-md-4 w-100 w-md-auto">

                                    <span class="fs-2 fw-bold text-primary">$@trip.Price</span>

                                    <a asp-action="Details"
                                       asp-route-id="@trip.Id"
                                       class="btn btn-primary fw-bold px-4 py-2 rounded-3 text-center w-100 glow-primary"
                                       style="font-size: 0.875rem;">
                                        Select Flight
                                    </a>

                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-white-50 py-5">
                        <p class="fs-5 mb-0">No flights found.</p>
                    </div>
                }

                <!-- Pagination -->
                @{
                    var departureDateStr = Model.SearchTripsVM.DepartureTime != default ? Model.SearchTripsVM.DepartureTime.ToString("yyyy-MM-dd") : "";
                }
                @if (Model.SearchTripsVM.TotalPages > 1)
                {
                    <div class="d-flex justify-content-center align-items-center gap-2 mt-4">
                        @if (Model.SearchTripsVM.CurrentPage > 1)
                        {
                            <a asp-action="SearchTrips"
                               asp-route-page="@(Model.SearchTripsVM.CurrentPage - 1)"
                               asp-route-DepartureCity="@Model.SearchTripsVM.DepartureCity"
                               asp-route-ArrivalCity="@Model.SearchTripsVM.ArrivalCity"
                               asp-route-DepartureTime="@departureDateStr"
                               asp-route-MaxPrice="@Model.SearchTripsVM.MaxPrice"
                               class="pagination-btn">
                                Previous
                            </a>
                        }

                        @for (int i = Math.Max(1, Model.SearchTripsVM.CurrentPage - 2); i <= Math.Min(Model.SearchTripsVM.TotalPages, Model.SearchTripsVM.CurrentPage + 2); i++)
                        {
                            var isActive = i == Model.SearchTripsVM.CurrentPage;
                            <a asp-action="SearchTrips"
                               asp-route-page="@i"
                               asp-route-DepartureCity="@Model.SearchTripsVM.DepartureCity"
                               asp-route-ArrivalCity="@Model.SearchTripsVM.ArrivalCity"
                               asp-route-DepartureTime="@departureDateStr"
                               asp-route-MaxPrice="@Model.SearchTripsVM.MaxPrice"
                               class="pagination-btn @(isActive ? "active" : "")">
                                @i
                            </a>
                        }

                        @if (Model.SearchTripsVM.CurrentPage < Model.SearchTripsVM.TotalPages)
                        {
                            <a asp-action="SearchTrips"
                               asp-route-page="@(Model.SearchTripsVM.CurrentPage + 1)"
                               asp-route-DepartureCity="@Model.SearchTripsVM.DepartureCity"
                               asp-route-ArrivalCity="@Model.SearchTripsVM.ArrivalCity"
                               asp-route-DepartureTime="@departureDateStr"
                               asp-route-MaxPrice="@Model.SearchTripsVM.MaxPrice"
                               class="pagination-btn">
                                Next
                            </a>
                        }
                    </div>
                    <div class="text-center mt-3 text-white-50" style="font-size: 0.875rem;">
                        Showing flights @(((Model.SearchTripsVM.CurrentPage - 1) * Model.SearchTripsVM.PageSize) + 1) to @Math.Min(Model.SearchTripsVM.CurrentPage * Model.SearchTripsVM.PageSize, Model.SearchTripsVM.TotalItems) of @Model.SearchTripsVM.TotalItems
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<script>
    const range = document.querySelector("input[name='SearchTripsVM.MaxPrice']");
    const price = document.getElementById("priceValue");

    range.addEventListener("input", () => {
        price.innerText = "$" + range.value;
    });
</script>
