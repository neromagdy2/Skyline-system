@model IEnumerable<Airport_Managment_SYS.Models.Reservation>

<section style="max-width: 1024px; margin-bottom:40px; margin-top:40px; auto;">
    <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-4 mb-5">
        <h1 class="display-5 fw-bold text-white" style="letter-spacing: -0.02em;">
            My Bookings
        </h1>
    </div>

    @if (!Model?.Any() ?? true)
    {
        <!-- Empty State -->
        <div class="glass-card rounded-4 p-5 text-center">
            <div class="empty-state-icon">
                <i class="bi bi-ticket-perforated"></i>
            </div>
            <h2 class="h4 fw-bold text-white mb-2">No bookings yet</h2>
            <p class="text-white-50 mb-4 mx-auto" style="max-width: 400px;">
                When you reserve a flight, it will show up here. You can pay and manage your trips from this page.
            </p>
            <a href="/Customer/Home/Index" class="btn btn-primary fw-bold px-4 py-3 rounded-3 d-inline-flex align-items-center gap-2 glow-primary">
                <i class="bi bi-search"></i>
                Find flights
            </a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var r in Model)
            {
                var trip = r.Trip;
                <article class="glass-card rounded-4 p-3 p-md-4">
                    <div class="row align-items-center g-3">

                        <!-- Flight Icon -->
                        <div class="col-auto">
                            <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px; background: rgba(59, 130, 246, 0.2);">
                                <i class="bi bi-airplane text-primary fs-4"></i>
                            </div>
                        </div>

                        <!-- Route Info -->
                        <div class="col-auto">
                            <div class="d-flex flex-column text-white">
                                <span class="fw-bold" style="font-size: 0.875rem;">
                                    @(trip != null ? $"{trip.Airport_From?.Name ?? "—"} → {trip.Airport_To?.Name ?? "—"}" : "Trip")
                                </span>
                                <span class="text-white-50" style="font-size: 0.75rem;">Booking #@r.Id</span>
                            </div>
                        </div>

                        <!-- Departure -->
                        <div class="col text-center text-md-start">
                            <span class="d-block text-uppercase fw-bold text-white-50" style="font-size: 0.625rem; letter-spacing: 0.1em;">Departure</span>
                            <span class="d-block fw-medium text-white">@(trip?.DateTime.ToString("MMM d, h:mm tt") ?? "—")</span>
                        </div>

                        <!-- Arrival -->
                        <div class="col text-center text-md-start">
                            <span class="d-block text-uppercase fw-bold text-white-50" style="font-size: 0.625rem; letter-spacing: 0.1em;">Arrival</span>
                            <span class="d-block fw-medium text-white">@(trip?.ArrivalDateTime.ToString("MMM d, h:mm tt") ?? "—")</span>
                        </div>

                        <!-- Seats -->
                        <div class="col text-center text-md-start">
                            <span class="d-block text-uppercase fw-bold text-white-50" style="font-size: 0.625rem; letter-spacing: 0.1em;">Seats</span>
                            <span class="d-block fw-medium text-white">@r.NumSeats × Class #@r.SeatClassId</span>
                        </div>

                        <!-- Total -->
                        <div class="col text-center text-md-end">
                            <span class="d-block text-uppercase fw-bold text-white-50" style="font-size: 0.625rem; letter-spacing: 0.1em;">Total</span>
                            <span class="d-block fs-5 fw-bold text-primary">@r.TotalPrice.ToString("C")</span>
                        </div>

                        <!-- Status & Actions -->
                        <div class="col-12 col-md-auto">
                            <div class="d-flex flex-row flex-md-column align-items-center align-items-md-end justify-content-between gap-2 gap-md-2 border-top border-md-top-0 border-md-start border-white border-opacity-10 pt-2 pt-md-0 ps-md-3">
                                @if (r.IsPaid)
                                {
                                    <span class="status-badge status-badge-paid">
                                        <span class="status-dot status-dot-paid"></span>
                                        Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge-pending">
                                        <span class="status-dot status-dot-pending"></span>
                                        Pending
                                    </span>
                                }
                                <div class="d-flex flex-wrap gap-2">
                                    @if (r.IsPaid)
                                    {
                                        <a href="@Url.Action("Index", "Reservations", new { area = "Customer" })"
                                           class="btn-action">
                                            <i class="bi bi-card-list"></i>
                                            Manage
                                        </a>
                                        <a href="@Url.Action("DownloadTicket", "Reservations", new { area = "Customer", id = r.Id })"
                                           class="btn-action">
                                            <i class="bi bi-download"></i>
                                            Ticket
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("pay", "Payments", new { area = "Customer", id = r.Id })"
                                           class="btn-pay">
                                            <i class="bi bi-credit-card"></i>
                                            Pay now
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>

                    </div>
                </article>
            }
        </div>
    }
</section>
