@model IEnumerable<Airport_Managment_SYS.Models.Reservation>

<section style="max-width: 1024px; margin: 0 auto;">
    <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-4 mb-5">
        <h1 class="display-5 fw-bold text-white" style="letter-spacing: -0.02em;">
            My Bookings
        </h1>
    </div>

    @if (!Model?.Any() ?? true)
    {
        <!-- Empty State -->
        <div class="glass-card rounded-4 p-5 p-md-5 text-center">
            <div class="empty-state-icon">
                <i class="bi bi-ticket-perforated"></i>
            </div>
            <h2 class="h4 fw-bold text-white mb-2">No bookings yet</h2>
            <p class="text-white-50 mb-4 mx-auto" style="max-width: 400px;">
                When you reserve a flight, it will show up here. You can pay and manage your trips from this page.
            </p>
            <a href="/Customer/Home/Index" class="btn btn-primary fw-bold px-4 py-3 rounded-3 d-inline-flex align-items-center gap-2 glow-primary">
                <i class="bi bi-search"></i>
                Find flights
            </a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var r in Model)
            {
                var trip = r.Trip;
                <article class="booking-card">
                    <div class="p-4 p-sm-5">
                        <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center gap-4 gap-lg-5">

                            <!-- Route & Times -->
                            <div class="flex-grow-1 w-100" style="min-width: 0;">
                                <div class="d-flex align-items-center gap-3 mb-4">
                                    <div class="d-flex align-items-center justify-content-center rounded-3 flex-shrink-0" style="width: 40px; height: 40px; background: rgba(59, 130, 246, 0.2);">
                                        <i class="bi bi-airplane text-primary"></i>
                                    </div>
                                    <div>
                                        <h2 class="fw-bold text-white h5 mb-0">
                                            @(trip != null ? $"{trip.Airport_From?.Name ?? "—"} → {trip.Airport_To?.Name ?? "—"}" : "Trip")
                                        </h2>
                                        <p class="text-white-50 mb-0" style="font-size: 0.75rem;">
                                            Booking #@r.Id
                                        </p>
                                    </div>
                                </div>
                                <div class="row g-3" style="font-size: 0.875rem;">
                                    <div class="col-6 col-sm-3">
                                        <p class="text-uppercase fw-bold text-white-50 mb-1" style="font-size: 0.625rem; letter-spacing: 0.1em;">Departure</p>
                                        <p class="fw-medium text-white mb-0">@(trip?.DateTime.ToString("MMM d, h:mm tt") ?? "—")</p>
                                    </div>
                                    <div class="col-6 col-sm-3">
                                        <p class="text-uppercase fw-bold text-white-50 mb-1" style="font-size: 0.625rem; letter-spacing: 0.1em;">Arrival</p>
                                        <p class="fw-medium text-white mb-0">@(trip?.ArrivalDateTime.ToString("MMM d, h:mm tt") ?? "—")</p>
                                    </div>
                                    <div class="col-6 col-sm-3">
                                        <p class="text-uppercase fw-bold text-white-50 mb-1" style="font-size: 0.625rem; letter-spacing: 0.1em;">Seats</p>
                                        <p class="fw-medium text-white mb-0">@r.NumSeats × Class #@r.SeatClassId</p>
                                    </div>
                                    <div class="col-6 col-sm-3">
                                        <p class="text-uppercase fw-bold text-white-50 mb-1" style="font-size: 0.625rem; letter-spacing: 0.1em;">Total</p>
                                        <p class="fs-5 fw-bold text-primary mb-0">@r.TotalPrice.ToString("C")</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Status & Actions -->
                            <div class="d-flex flex-row flex-lg-column align-items-center gap-3 flex-shrink-0 pt-3 pt-lg-0 border-top border-lg-top-0 border-lg-start border-white border-opacity-10 ps-lg-4 w-100 w-lg-auto">
                                @if (r.IsPaid)
                                {
                                    <span class="status-badge status-badge-paid">
                                        <span class="status-dot status-dot-paid"></span>
                                        Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge-pending">
                                        <span class="status-dot status-dot-pending"></span>
                                        Pending payment
                                    </span>
                                }
                                <div class="d-flex flex-wrap gap-2">
                                    <div class="d-flex flex-wrap gap-2 flex-column">
                                        @if (r.IsPaid)
                                        {
                                            <a href="@Url.Action("Index", "Reservations", new { area = "Customer" })"
                                               class="btn-action">
                                                <i class="bi bi-card-list"></i>
                                                Manage
                                            </a>
                                            <a href="@Url.Action("DownloadTicket", "Reservations", new { area = "Customer", id = r.Id })"
                                               class="btn-action">
                                                <i class="bi bi-download"></i>
                                                Download Ticket
                                            </a>
                                        }
                                    </div>
                                    @if (!r.IsPaid)
                                    {
                                        <a href="@Url.Action("pay", "Payments", new { area = "Customer", id = r.Id })"
                                           class="btn-pay">
                                            <i class="bi bi-credit-card"></i>
                                            Pay now
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>
