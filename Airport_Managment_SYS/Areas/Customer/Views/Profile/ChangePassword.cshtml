@using Airport_Managment_SYS.Areas.Identity.ViewModels
@model ChangePasswordAuthenticatedVM

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="form-card p-4 p-md-5" style="max-width: 650px; width: 100%;">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-white mb-1">Change Password</h3>
                <p class="text-white-50 mb-0" style="font-size: 0.875rem;">Update your password securely</p>
            </div>
            <a asp-area="Identity" asp-controller="Profile" asp-action="Index" class="btn-profile-outline">
                <i class="bi bi-arrow-left me-1"></i>Back
            </a>
        </div>

        <form asp-area="Identity" asp-controller="Profile" asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Current Password -->
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label-dark"></label>
                <input asp-for="CurrentPassword" type="password" class="form-control-dark w-100" />
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>

            <!-- New Password -->
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label-dark"></label>
                <input asp-for="NewPassword" type="password" class="form-control-dark w-100" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <!-- Confirm New Password -->
            <div class="mb-4">
                <label asp-for="ConfirmNewPassword" class="form-label-dark"></label>
                <input asp-for="ConfirmNewPassword" type="password" class="form-control-dark w-100" />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
            </div>

            <!-- Actions -->
            <div class="d-flex justify-content-end gap-2">
                <button type="submit" class="btn-profile-warning">
                    <i class="bi bi-shield-check me-1"></i>Change Password
                </button>
                <a asp-area="Identity" asp-controller="Profile" asp-action="Index" class="btn-profile-outline">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <partial name="_NotificationPartial" />
    }
}
