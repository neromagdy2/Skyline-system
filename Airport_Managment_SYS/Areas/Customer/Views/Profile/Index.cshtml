@using Airport_Managment_SYS.Areas.Identity.ViewModels
@model ProfileVM

@{
    ViewData["Title"] = "My Profile";
}

<div class="container-fluid py-4 px-lg-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h4 class="fw-bold text-dark mb-1">Account Settings</h4>
                </div>
                <div class="d-none d-md-block">
                    <a asp-area="Identity" asp-controller="Authentication" asp-action="Logout" class="btn btn-sm btn-outline-danger px-3 rounded-pill">
                        <i class="fas fa-sign-out-alt me-1"></i>Logout
                    </a>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-body text-center py-5 px-3">
                            <div class="position-relative d-inline-block mb-3">
                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center shadow-sm mx-auto" style="width: 100px; height: 100px;">
                                    <i class="fas fa-user-tie fa-3x text-primary"></i>
                                </div>
                            </div>
                            <h5 class="fw-bold mb-1">@Model.UserName</h5>
                            <p class="text-muted small mb-4">@Model.Email</p>
                            <div class="d-grid gap-4 px-4">
                                <a asp-area="Customer" asp-controller="Profile" asp-action="Edit" class="btn btn-primary btn-sm py-2">Update Profile</a>
                                <a asp-area="Customer" asp-controller="Profile" asp-action="ChangePassword" class="btn btn-outline-warning btn-sm py-2">Change Password</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-8">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-transparent border-0 pt-4 px-4">
                            <h6 class="fw-bold mb-0 text-primary small text-uppercase">Personal Details</h6>
                        </div>
                        <div class="card-body p-4 pt-0">
                            <div class="list-group list-group-flush">
                                <div class="list-group-item px-0 py-3 border-0 border-bottom">
                                    <div class="row align-items-center">
                                        <div class="col-4 text-muted small fw-bold text-uppercase">Username</div>
                                        <div class="col-8 text-dark fw-semibold">@Model.UserName</div>
                                    </div>
                                </div>
                                <div class="list-group-item px-0 py-3 border-0 border-bottom">
                                    <div class="row align-items-center">
                                        <div class="col-4 text-muted small fw-bold text-uppercase">Email Address</div>
                                        <div class="col-8 text-dark fw-semibold">@Model.Email</div>
                                    </div>
                                </div>
                                <div class="list-group-item px-0 py-3 border-0 border-bottom">
                                    <div class="row align-items-center">
                                        <div class="col-4 text-muted small fw-bold text-uppercase">Phone</div>
                                        <div class="col-8 text-dark fw-semibold">@(!string.IsNullOrEmpty(Model.PhoneNumber) ? Model.PhoneNumber : "Not provided")</div>
                                    </div>
                                </div>
                                <div class="list-group-item px-0 py-3 border-0 border-bottom">
                                    <div class="row align-items-center">
                                        <div class="col-4 text-muted small fw-bold text-uppercase">Nationality</div>
                                        <div class="col-8 text-dark fw-semibold">@(Model.National?.Name ?? "Not provided")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <partial name="_NotificationPartial" />
    }
}
