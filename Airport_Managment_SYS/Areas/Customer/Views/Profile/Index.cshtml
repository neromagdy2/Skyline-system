@using Airport_Managment_SYS.Areas.Identity.ViewModels
@model ProfileVM

@{
    ViewData["Title"] = "My Profile";
}

<div class="container-fluid py-5 px-4 px-lg-5" style="max-width: 1400px; margin: 0 auto;">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h4 class="fw-bold text-white mb-1">Account Settings</h4>
                    <p class="text-white-50 mb-0" style="font-size: 0.875rem;">Manage your account details and preferences</p>
                </div>
                <div class="d-none d-md-block">
                    <a asp-area="Identity" asp-controller="Authentication" asp-action="Logout" class="btn-profile-danger">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </a>
                </div>
            </div>

            <div class="row g-4">
                <!-- Profile Card -->
                <div class="col-12 col-lg-4">
                    <div class="profile-card">
                        <div class="card-body text-center py-5 px-3">
                            <div class="position-relative d-inline-block mb-3">
                                <div class="profile-avatar mx-auto">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                            </div>
                            <h5 class="fw-bold text-white mb-1">@Model.UserName</h5>
                            <p class="text-white-50 small mb-4">@Model.Email</p>
                            <div class="d-grid gap-3 px-3">
                                <a asp-area="Customer" asp-controller="Profile" asp-action="Edit" class="btn-profile-primary btn-sm py-2">
                                    <i class="bi bi-pencil-square me-2"></i>Update Profile
                                </a>
                                <a asp-area="Customer" asp-controller="Profile" asp-action="ChangePassword" class="btn-profile-outline btn-sm py-2">
                                    <i class="bi bi-shield-lock me-2"></i>Change Password
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Details Card -->
                <div class="col-12 col-lg-8">
                    <div class="profile-card h-100">
                        <div class="profile-card-header">
                            <h6>Personal Details</h6>
                        </div>
                        <div class="card-body p-4">
                            <div class="list-group list-group-flush">
                                <div class="profile-detail-item">
                                    <div class="row align-items-center">
                                        <div class="col-4 profile-detail-label">Username</div>
                                        <div class="col-8 profile-detail-value">@Model.UserName</div>
                                    </div>
                                </div>
                                <div class="profile-detail-item">
                                    <div class="row align-items-center">
                                        <div class="col-4 profile-detail-label">Email Address</div>
                                        <div class="col-8 profile-detail-value">@Model.Email</div>
                                    </div>
                                </div>
                                <div class="profile-detail-item">
                                    <div class="row align-items-center">
                                        <div class="col-4 profile-detail-label">Phone</div>
                                        <div class="col-8 profile-detail-value">@(!string.IsNullOrEmpty(Model.PhoneNumber) ? Model.PhoneNumber : "Not provided")</div>
                                    </div>
                                </div>
                                <div class="profile-detail-item">
                                    <div class="row align-items-center">
                                        <div class="col-4 profile-detail-label">Nationality</div>
                                        <div class="col-8 profile-detail-value">@(Model.National?.Name ?? "Not provided")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <partial name="_NotificationPartial" />
    }
}
