@model IEnumerable<ApplicationUser>


	<div class="container mt-5">

      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Users Management</h2>
        <a asp-action="Create" class="btn btn-primary">
            + Add New User
        </a>
      </div>
	</div>
	
    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-striped table-hover align-middle text-center">
                <thead class="table-dashboard">
			    <tr>
				   <th>Name</th>
				   <th>Email</th>
				   <th>Phone Number</th>
				   <th>Actions</th>
				   <th>lock/unlock</th>

			    </tr>
		</div>
		</thead>
		<tbody>
			@foreach (var user in Model)
			{
				<tr>
					<td>@user.UserName</td>
					<td>@user.Email</td>
					<td>@user.PhoneNumber</td>
					<td>
					<a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-warning btn-sm me-2">Edit</a> |
					<a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-danger btn-sm"
					   onsubmit="return confirm('Are you sure you want to delete this user?');" 
						>Delete
					</a>
					
					</td> 
					<td>
						@if (user.LockoutEnd > DateTime.UtcNow && user.LockoutEnd != null)
						{
							<a asp-action="LockUnlock" asp-route-id="@user.Id" class="btn btn-success">Unlock</a>
						}
						else
						{
							<a asp-action="LockUnlock" asp-route-id="@user.Id" class="btn btn-secondary">Lock</a>
						}

					</td>
						
				</tr>
			}

		</tbody>
      </div>

