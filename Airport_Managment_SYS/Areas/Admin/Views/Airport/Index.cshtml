@{
}
@model IEnumerable<Airport_Managment_SYS.Models.Airport>

@{
    ViewData["Title"] = "Airports";
}


<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Airports Management</h2>
        <a asp-action="Create" class="btn btn-primary">
            + Add New Airport
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-striped table-hover align-middle text-center">
                <thead class="table-dashboard">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Governorate</th>
                        <th width="180px">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int counter = 1;
                        foreach (var airport in Model)
                        {
                            <tr>
                                <td>@counter</td>
                                <td>@airport.Name</td>
                                <td>@airport.Description</td>
                                <td>@airport.GovernerateState?.Name</td>
                                <td class="d-flex flex-row align-content-center justify-content-center">
                                    <a asp-action="Edit"
                                       asp-route-id="@airport.Id"
                                       class="btn btn-warning btn-sm me-2">
                                        Edit
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@airport.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this airTport?');">

                                        <button type="submit" class="btn btn-danger btn-sm">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>

                            counter++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-muted">
                                No Airports Found
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
            
            <partial name="_AdminPaginationPartial" />

        </div>
    </div>

</div>