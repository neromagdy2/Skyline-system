@model IEnumerable<Trip>
@{
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 10;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var searchBy = ViewBag.SearchBy as string ?? "all";
    var totalItems = ViewBag.TotalItems as int? ?? 0;
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold mb-1">
                        <i class="bi bi-airplane-engines text-primary"></i> Trips Management
                    </h2>
                    <p class="text-muted mb-0">Manage and search flight trips efficiently</p>
                </div>
                <div>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i> Add New Trip
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Card -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <h5 class="mb-0">
                <i class="bi bi-search me-2"></i> Advanced Search
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get">
                <input type="hidden" name="page" value="1" />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Search Term</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="searchTerm" value="@searchTerm" 
                                   class="form-control border-start-0" placeholder="Enter search term..." />
                        </div>
                    </div>
                    
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Search By</label>
                        <select name="searchBy" class="form-select border-primary">
                            @if (searchBy == "all")
                            {
                                <option value="all" selected>🔍 All Fields</option>
                            }
                            else
                            {
                                <option value="all">🔍 All Fields</option>
                            }
                            @if (searchBy == "from")
                            {
                                <option value="from" selected>🛫 From Airport</option>
                            }
                            else
                            {
                                <option value="from">🛫 From Airport</option>
                            }
                            @if (searchBy == "to")
                            {
                                <option value="to" selected>🛬 To Airport</option>
                            }
                            else
                            {
                                <option value="to">🛬 To Airport</option>
                            }
                            @if (searchBy == "route")
                            {
                                <option value="route" selected>🛩️ Route</option>
                            }
                            else
                            {
                                <option value="route">🛩️ Route</option>
                            }
                            @if (searchBy == "airplane")
                            {
                                <option value="airplane" selected>✈️ Airplane</option>
                            }
                            else
                            {
                                <option value="airplane">✈️ Airplane</option>
                            }
                            @if (searchBy == "price")
                            {
                                <option value="price" selected>💰 Max Price</option>
                            }
                            else
                            {
                                <option value="price">💰 Max Price</option>
                            }
                        </select>
                    </div>
                    
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Page Size</label>
                        <select name="pageSize" class="form-select border-primary" onchange="this.form.submit()">
                            @if (pageSize == 5)
                            {
                                <option value="5" selected>5</option>
                            }
                            else
                            {
                                <option value="5">5</option>
                            }
                            @if (pageSize == 10)
                            {
                                <option value="10" selected>10</option>
                            }
                            else
                            {
                                <option value="10">10</option>
                            }
                            @if (pageSize == 25)
                            {
                                <option value="25" selected>25</option>
                            }
                            else
                            {
                                <option value="25">25</option>
                            }
                            @if (pageSize == 50)
                            {
                                <option value="50" selected>50</option>
                            }
                            else
                            {
                                <option value="50">50</option>
                            }
                        </select>
                    </div>
                    
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">&nbsp;</label>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search me-1"></i> Search
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-clockwise me-1"></i> Clear
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Summary -->
    @if (!string.IsNullOrEmpty(searchTerm))
    {
        <div class="alert alert-info d-flex align-items-center mb-3">
            <i class="bi bi-info-circle-fill me-2"></i>
            <div>
                Found <strong>@totalItems</strong> trips matching "<strong>@searchTerm</strong>" in <strong>@searchBy</strong>
                @if (totalItems > pageSize)
                {
                    <text> - Page @currentPage of @totalPages</text>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-light d-flex align-items-center mb-3">
            <i class="bi bi-list-ul me-2"></i>
            <div>
                Showing <strong>@totalItems</strong> total trips
                @if (totalItems > pageSize)
                {
                    <text> - Page @currentPage of @totalPages</text>
                }
            </div>
        </div>
    }

    <!-- Trips Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th scope="col" class="border-0">#</th>
                            <th scope="col" class="border-0">🛫 Departure</th>
                            <th scope="col" class="border-0">🛬 Arrival</th>
                            <th scope="col" class="border-0">💰 Price</th>
                            <th scope="col" class="border-0">🛩️ Route</th>
                            <th scope="col" class="border-0">✈️ Airplane</th>
                            <th scope="col" class="border-0 text-center">🔧 Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="border-bottom">
                                    <th scope="row" class="fw-bold">@item.Id</th>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <small class="text-muted">@item.DateTime.ToString("MMM dd, yyyy")</small>
                                            <strong class="text-primary">@item.DateTime.ToString("HH:mm")</strong>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <small class="text-muted">@item.ArrivalDateTime.ToString("MMM dd, yyyy")</small>
                                            <strong class="text-success">@item.ArrivalDateTime.ToString("HH:mm")</strong>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-success fs-6 px-3 py-2">@item.Price.ToString("C")</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center flex-wrap gap-1">
                                            <span class="badge bg-primary">@(item.Airport_From?.Name ?? "Unknown")</span>
                                            <i class="bi bi-arrow-right text-muted mx-1"></i>
                                            <span class="badge bg-info">@(item.Airport_To?.Name ?? "Unknown")</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@(item.Airplane?.Model ?? "Unknown")</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               asp-route-page="@currentPage"
                                               asp-route-searchTerm="@searchTerm"
                                               asp-route-searchBy="@searchBy"
                                               class="btn btn-warning btn-sm">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Delete"
                                                  asp-route-id="@item.Id"
                                                  asp-route-page="@currentPage"
                                                  asp-route-searchTerm="@searchTerm"
                                                  asp-route-searchBy="@searchBy"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this Trip?');">
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="bi bi-search fs-1 d-block mb-3"></i>
                                        <h5>No trips found matching your criteria.</h5>
                                        <p class="mb-3">Try adjusting your search terms or filters.</p>
                                        <a asp-action="Index" class="btn btn-outline-primary">
                                            <i class="bi bi-arrow-clockwise me-2"></i>Clear Search
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Enhanced Pagination -->
    @if (totalPages > 1)
    {
        <nav aria-label="Trips pagination" class="mt-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div class="text-muted mb-2 mb-md-0">
                    <small>
                        Showing @((currentPage - 1) * pageSize + 1)-@(Math.Min(currentPage * pageSize, totalItems)) of @totalItems trips
                    </small>
                </div>
                <ul class="pagination mb-0">
                    @if (currentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" 
                               asp-action="Index" 
                               asp-route-page="@(currentPage - 1)"
                               asp-route-searchTerm="@searchTerm"
                               asp-route-searchBy="@searchBy">
                                <i class="bi bi-chevron-left"></i> Previous
                            </a>
                        </li>
                    }

                    @* Smart pagination with ellipsis *@
                    @{
                        var startPage = Math.Max(1, currentPage - 2);
                        var endPage = Math.Min(totalPages, currentPage + 2);
                        
                        if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-searchTerm="@searchTerm" asp-route-searchBy="@searchBy">1</a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        
                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" 
                                   asp-action="Index" 
                                   asp-route-page="@i"
                                   asp-route-searchTerm="@searchTerm"
                                   asp-route-searchBy="@searchBy">
                                    @i
                                </a>
                            </li>
                        }
                        
                        if (endPage < totalPages)
                        {
                            if (endPage < totalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="@totalPages" asp-route-searchTerm="@searchTerm" asp-route-searchBy="@searchBy">@totalPages</a>
                            </li>
                        }
                    }

                    @if (currentPage < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" 
                               asp-action="Index" 
                               asp-route-page="@(currentPage + 1)"
                               asp-route-searchTerm="@searchTerm"
                               asp-route-searchBy="@searchBy">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    }
</div>

<style>
    .table th {
        font-weight: 600;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .table td {
        vertical-align: middle;
        border-color: #f1f3f5;
    }
    
    .btn-group .btn {
        border-radius: 0.375rem !important;
    }
    
    .card {
        transition: transform 0.2s ease-in-out;
    }
    
    .card:hover {
        transform: translateY(-2px);
    }
    
    .badge {
        font-weight: 500;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const deleteButtons = document.querySelectorAll(".btn-delete");

        deleteButtons.forEach(button => {
            button.addEventListener("click", function (e) {
                e.preventDefault();
                const url = this.getAttribute("href");

                Swal.fire({
                    title: "Delete Trip?",
                    text: "This will permanently remove this flight schedule!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#3085d6",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });
        });
    });
</script>

@section Scripts {
    <partial name="_NotificationPartial" />
}
