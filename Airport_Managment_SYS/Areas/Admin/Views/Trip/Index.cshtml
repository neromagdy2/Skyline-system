@model IEnumerable<Trip>


    <div class="container mt-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold">Trips Management</h2>
            <a asp-action="Create" class="btn btn-primary">
                + Add New Trip
            </a>
        </div>


    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-striped table-hover align-middle text-center">
                <thead class="table-dashboard">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Departure</th>
                        <th scope="col">Arrival</th>
                        <th scope="col">Price</th>
                        <th scope="col">From / To</th>
                        <th scope="col">Airplane ID</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <th scope="row">@item.Id</th>
                            <td>@item.DateTime.ToString("g")</td>
                            <td>@item.ArrivalDateTime.ToString("g")</td>
                            <td>@item.Price.ToString("C")</td> @* Formats as Currency: $150.00 *@
                            <td>
                                <span class="badge bg-secondary">@item.Airport_FromId</span>
                                <i class="bi bi-arrow-right"></i>
                                <span class="badge bg-info">@item.Airport_ToId</span>
                            </td>
                            <td>ID: @item.AirplaneId</td>
                            <td>
                                <a href="/Admin/Trip/Update/@item.Id" class="btn btn-warning">Edit</a>
                                <a href="/Admin/Trip/Delete/@item.Id" class="btn btn-danger btn-delete" >Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const deleteButtons = document.querySelectorAll(".btn-delete");

        deleteButtons.forEach(button => {
            button.addEventListener("click", function (e) {
                e.preventDefault();
                const url = this.getAttribute("href");

                Swal.fire({
                    title: "Delete Trip?",
                    text: "This will permanently remove this flight schedule!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#3085d6",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });
        });
    });
</script>

@section Scripts {
    <partial name="_NotificationPartial" />
}
