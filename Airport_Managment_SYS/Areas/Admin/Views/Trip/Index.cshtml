@model IEnumerable<Trip>
@{
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 10;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var totalItems = ViewBag.TotalItems as int? ?? 0;
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Trips Management</h2>
        <a asp-action="Create" class="btn btn-primary">
            + Add New Trip
        </a>
    </div>

    <!-- Search Form -->
    <div class="row mb-4">
        <div class="col-md-6">
            <form asp-action="Index" method="get" class="d-flex">
                <input type="hidden" name="page" value="1" />
                <div class="input-group">
                    <input type="text" name="searchTerm" value="@searchTerm" 
                           class="form-control" placeholder="Search by airport, airplane, or route..." />
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Summary -->
    <div class="alert alert-info mb-3">
        Showing @totalItems trips 
        @if (!string.IsNullOrEmpty(searchTerm))
        {
            <text>matching "@searchTerm"</text>
        }
        @if (totalItems > pageSize)
        {
            <text> - Page @currentPage of @totalPages</text>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle text-center">
                    <thead class="table-dashboard">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Departure</th>
                            <th scope="col">Arrival</th>
                            <th scope="col">Price</th>
                            <th scope="col">From / To</th>
                            <th scope="col">Airplane ID</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <th scope="row">@item.Id</th>
                                <td>@item.DateTime.ToString("g")</td>
                                <td>@item.ArrivalDateTime.ToString("g")</td>
                                <td>@item.Price.ToString("C")</td> @* Formats as Currency: $150.00 *@
                                <td>
                                    <span class="badge bg-secondary">@item.Airport_FromId</span>
                                    <i class="bi bi-arrow-right"></i>
                                    <span class="badge bg-info">@item.Airport_ToId</span>
                                </td>
                                <td>ID: @item.AirplaneId</td>
                                <td class="d-flex flex-row">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       asp-route-page="@currentPage"
                                       asp-route-searchTerm="@searchTerm"
                                       class="btn btn-warning btn-sm me-2">
                                        Edit
                                    </a>
                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          asp-route-page="@currentPage"
                                          asp-route-searchTerm="@searchTerm"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this Trip?');">
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav aria-label="Trips pagination">
            <ul class="pagination justify-content-center">
                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" 
                           asp-action="Index" 
                           asp-route-page="@(currentPage - 1)"
                           asp-route-searchTerm="@searchTerm">
                            <i class="bi bi-chevron-left"></i> Previous
                        </a>
                    </li>
                }

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" 
                           asp-action="Index" 
                           asp-route-page="@i"
                           asp-route-searchTerm="@searchTerm">
                            @i
                        </a>
                    </li>
                }

                @if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link" 
                           asp-action="Index" 
                           asp-route-page="@(currentPage + 1)"
                           asp-route-searchTerm="@searchTerm">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const deleteButtons = document.querySelectorAll(".btn-delete");

        deleteButtons.forEach(button => {
            button.addEventListener("click", function (e) {
                e.preventDefault();
                const url = this.getAttribute("href");

                Swal.fire({
                    title: "Delete Trip?",
                    text: "This will permanently remove this flight schedule!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#3085d6",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });
        });
    });
</script>

@section Scripts {
    <partial name="_NotificationPartial" />
}
