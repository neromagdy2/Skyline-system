@model IEnumerable<Trip>
@{
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 10;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var searchBy = ViewBag.SearchBy as string ?? "all";
    var totalItems = ViewBag.TotalItems as int? ?? 0;
}

<div class="container mt-4">
    <!-- Simple Header -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h3 class="fw-bold">Trips Management</h3>
            <p class="text-muted">Search and manage flight trips</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-lg"></i> New Trip
            </a>
        </div>
    </div>

    <!-- Simple Search Bar -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <input type="hidden" name="page" value="1" />
                <div class="row g-2">
                    <div class="col-md-4">
                        <input type="text" name="searchTerm" value="@searchTerm" 
                               class="form-control" placeholder="Search trips..." />
                    </div>
                    <div class="col-md-2">
                        <select name="searchBy" class="form-select">
                            @if (searchBy == "all")
                            {
                                <option value="all" selected>All</option>
                            }
                            else
                            {
                                <option value="all">All</option>
                            }
                            @if (searchBy == "from")
                            {
                                <option value="from" selected>From</option>
                            }
                            else
                            {
                                <option value="from">From</option>
                            }
                            @if (searchBy == "to")
                            {
                                <option value="to" selected>To</option>
                            }
                            else
                            {
                                <option value="to">To</option>
                            }
                            @if (searchBy == "airplane")
                            {
                                <option value="airplane" selected>Airplane</option>
                            }
                            else
                            {
                                <option value="airplane">Airplane</option>
                            }
                            @if (searchBy == "price")
                            {
                                <option value="price" selected>Max Price</option>
                            }
                            else
                            {
                                <option value="price">Max Price</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="pageSize" class="form-select" onchange="this.form.submit()">
                            @if (pageSize == 5)
                            {
                                <option value="5" selected>5</option>
                            }
                            else
                            {
                                <option value="5">5</option>
                            }
                            @if (pageSize == 10)
                            {
                                <option value="10" selected>10</option>
                            }
                            else
                            {
                                <option value="10">10</option>
                            }
                            @if (pageSize == 25)
                            {
                                <option value="25" selected>25</option>
                            }
                            else
                            {
                                <option value="25">25</option>
                            }
                            @if (pageSize == 50)
                            {
                                <option value="50" selected>50</option>
                            }
                            else
                            {
                                <option value="50">50</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                    <div class="col-md-2">
                        <a asp-action="Index" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-x-lg"></i> Clear
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Info -->
    <div class="row mb-3">
        <div class="col-12">
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <span class="badge bg-info">
                    Found @totalItems results for "@searchTerm"
                </span>
            }
            else
            {
                <span class="text-muted">
                    Showing @totalItems trips
                    @if (totalItems > pageSize)
                    {
                        <text>(Page @currentPage of @totalPages)</text>
                    }
                </span>
            }
        </div>
    </div>

    <!-- Simple Table -->
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Departure</th>
                            <th>Arrival</th>
                            <th>Price</th>
                            <th>Route</th>
                            <th>Airplane</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.Id</strong></td>
                                    <td>
                                        <div>@item.DateTime.ToString("MMM dd")</div>
                                        <small class="text-muted">@item.DateTime.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <div>@item.ArrivalDateTime.ToString("MMM dd")</div>
                                        <small class="text-muted">@item.ArrivalDateTime.ToString("HH:mm")</small>
                                    </td>
                                    <td><span class="badge bg-success">@item.Price.ToString("C")</span></td>
                                    <td>
                                        <small>@item.Airport_From?.Name</small>
                                        <i class="bi bi-arrow-right mx-1"></i>
                                        <small>@item.Airport_To?.Name</small>
                                    </td>
                                    <td><small>@item.Airplane?.Model</small></td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               asp-route-page="@currentPage"
                                               asp-route-searchTerm="@searchTerm"
                                               asp-route-searchBy="@searchBy"
                                               class="btn btn-outline-primary">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Delete"
                                                  asp-route-id="@item.Id"
                                                  asp-route-page="@currentPage"
                                                  asp-route-searchTerm="@searchTerm"
                                                  asp-route-searchBy="@searchBy"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Delete this trip?');">
                                                <button type="submit" class="btn btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="bi bi-search fs-3"></i>
                                        <p>No trips found</p>
                                        <a asp-action="Index" class="btn btn-sm btn-outline-primary">Clear Search</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Simple Pagination -->
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted">
                <small>Showing @((currentPage - 1) * pageSize + 1)-@(Math.Min(currentPage * pageSize, totalItems)) of @totalItems</small>
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    @if (currentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" 
                               asp-action="Index" 
                               asp-route-page="@(currentPage - 1)"
                               asp-route-searchTerm="@searchTerm"
                               asp-route-searchBy="@searchBy">
                                Previous
                            </a>
                        </li>
                    }

                    @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" 
                               asp-action="Index" 
                               asp-route-page="@i"
                               asp-route-searchTerm="@searchTerm"
                               asp-route-searchBy="@searchBy">
                                @i
                            </a>
                        </li>
                    }

                    @if (currentPage < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" 
                               asp-action="Index" 
                               asp-route-page="@(currentPage + 1)"
                               asp-route-searchTerm="@searchTerm"
                               asp-route-searchBy="@searchBy">
                                Next
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const deleteButtons = document.querySelectorAll(".btn-delete");

        deleteButtons.forEach(button => {
            button.addEventListener("click", function (e) {
                e.preventDefault();
                const url = this.getAttribute("href");

                Swal.fire({
                    title: "Delete Trip?",
                    text: "This will permanently remove this flight schedule!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#3085d6",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });
        });
    });
</script>

@section Scripts {
    <partial name="_NotificationPartial" />
}
