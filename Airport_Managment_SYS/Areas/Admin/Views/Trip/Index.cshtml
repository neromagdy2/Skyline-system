@model IEnumerable<Airport_Managment_SYS.Models.Trip>
@{
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 10;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalItems = ViewBag.TotalItems as int? ?? 0;
    
    var fromSearch = ViewBag.FromSearch as string ?? "";
    var toSearch = ViewBag.ToSearch as string ?? "";
    var dateSearch = ViewBag.DateSearch as DateTime?;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Trips Management</h2>
        <a asp-action="Create" class="btn btn-primary fw-semi-bold rounded-pill px-4" style="background-color: #137fec; border-color: #137fec;">
            + Add New Trip
        </a>
    </div>

    <!-- Modern Search Bar (like screenshot) -->
    <div class="card shadow-sm border-0 rounded-4 mb-4" style="border-radius: 1rem !important;">
        <div class="card-body p-3">
            <form method="get" action="/Admin/Trip/Index" id="searchForm" class="row gx-2 gy-2 align-items-center">
                <!-- From -->
                <div class="col-12 col-md-3">
                    <div class="form-floating shadow-sm rounded-3">
                        <input type="text" class="form-control rounded-3 border-200" id="fromInput" name="fromSearch" value="@fromSearch" placeholder="From City or Airport">
                        <label for="fromInput" class="text-600 fw-semi-bold"><i class="fas fa-plane-departure text-400 me-2"></i>From</label>
                    </div>
                </div>
                <!-- To -->
                <div class="col-12 col-md-3">
                    <div class="form-floating shadow-sm rounded-3">
                        <input type="text" class="form-control rounded-3 border-200" id="toInput" name="toSearch" value="@toSearch" placeholder="To City or Airport">
                        <label for="toInput" class="text-600 fw-semi-bold"><i class="fas fa-plane-arrival text-400 me-2"></i>To</label>
                    </div>
                </div>
                <!-- Date -->
                <div class="col-12 col-md-3">
                    <div class="form-floating shadow-sm rounded-3">
                        <input type="date" class="form-control rounded-3 border-200" id="dateInput" name="dateSearch" value="@(dateSearch?.ToString("yyyy-MM-dd"))">
                        <label for="dateInput" class="text-600 fw-semi-bold"><i class="fas fa-calendar-alt text-400 me-2"></i>Date</label>
                    </div>
                </div>
                <!-- Search Button -->
                <div class="col-12 col-md-3">
                    <button type="submit" class="btn btn-primary w-100 h-100 rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="min-height: 58px; font-weight: 600; background-color: #137fec; border-color: #137fec;">
                        <span>Search again</span> <i class="fas fa-chevron-right ms-2 fs--2"></i>
                    </button>
                    <!-- Hidden page size param -->
                    <input type="hidden" name="pageSize" value="@pageSize" />
                    <input type="hidden" name="sortOrder" id="sortOrderInput" value="@ViewBag.SortOrder" />
                </div>
            </form>
        </div>
    </div>

    <!-- Results Header -->
    <div class="d-flex justify-content-between align-items-center mb-3 px-1">
        <h5 class="mb-0 text-700 fw-bold">
            @if(!string.IsNullOrEmpty(fromSearch) || !string.IsNullOrEmpty(toSearch))
            {
                <text>Select your departure flight </text>
                @if(!string.IsNullOrEmpty(fromSearch)) { <span class="text-900 ms-2">@fromSearch</span> }
                @if(!string.IsNullOrEmpty(fromSearch) && !string.IsNullOrEmpty(toSearch)) { <i class="fas fa-arrow-right mx-2 text-400 fs--1"></i> }
                @if(!string.IsNullOrEmpty(toSearch)) { <span class="text-900">@toSearch</span> }
            }
        </h5>
        
        <!-- Sorting Criteria Tab mimicking image -->
        <div class="dropdown">
            <button class="btn btn-sm btn-light border dropdown-toggle fw-semi-bold shadow-sm" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-sort-amount-down me-2"></i>
                @{
                    var sortLabel = ViewBag.SortOrder == "price_asc" ? "Cheapest first" : 
                                    ViewBag.SortOrder == "duration_asc" ? "Fastest first" : 
                                    ViewBag.SortOrder == "time_asc" ? "Earliest first" : "Other Sorting criteria";
                }
                @sortLabel
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item sort-btn @(ViewBag.SortOrder == "price_asc" ? "active" : "")" href="#" data-sort="price_asc">Cheapest</a></li>
                <li><a class="dropdown-item sort-btn @(ViewBag.SortOrder == "duration_asc" ? "active" : "")" href="#" data-sort="duration_asc">Fastest</a></li>
                <li><a class="dropdown-item sort-btn @(string.IsNullOrEmpty(ViewBag.SortOrder) || ViewBag.SortOrder == "time_asc" ? "active" : "")" href="#" data-sort="time_asc">Departure Time</a></li>
            </ul>
        </div>
    </div>

    <!-- Trips List -->
    <div class="d-flex flex-column gap-3 mb-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="card border border-200 shadow-sm hover-shadow transition-base flight-card" style="border-radius: 1rem !important;">
                    <div class="card-body p-4">
                        <div class="row align-items-center g-3">
                            
                            <!-- Airline Info -->
                            <div class="col-12 col-md-3 d-flex align-items-center">
                                <div class="avatar avatar-3xl me-3 bg-soft-primary d-flex justify-content-center align-items-center" style="border-radius: 0.75rem;">
                                    <span class="fas fa-plane text-primary fs-2"></span>
                                </div>
                                <div>
                                    <h5 class="mb-0 fw-bold text-800">@(item.Airplane?.Name ?? "Egyptair")</h5>
                                    <div class="fs--1 text-500 mt-1">ID: #@item.Id • @(item.Airplane?.Model ?? "")</div>
                                </div>
                            </div>
                            
                            <!-- Route & Time Info -->
                            <div class="col-12 col-md-6 px-lg-4">
                                <div class="row align-items-center text-center">
                                    <!-- Departure -->
                                    <div class="col-4 text-end pe-0 pe-md-3">
                                        <h3 class="mb-0 fw-bolder text-black">@item.DateTime.ToString("HH:mm")</h3>
                                        <div class="fs--1 text-700 fw-bold mt-1 text-truncate" title="@(item.Airport_From?.Name)">
                                            @(item.Airport_From?.GovernerateState?.Name ?? "LXR")
                                        </div>
                                    </div>
                                    
                                    <!-- Flight duration / stops -->
                                    <div class="col-4 px-0 position-relative">
                                        @{
                                            var duration = item.ArrivalDateTime - item.DateTime;
                                            var hours = (int)Math.Max(0, duration.TotalHours);
                                            var mins = Math.Max(0, duration.Minutes);
                                            var durationStr = hours > 0 ? $"{hours}h " : "";
                                            durationStr += mins > 0 || hours == 0 ? $"{mins}m" : "";
                                        }
                                        <div class="position-relative w-100 d-flex align-items-center justify-content-center my-3">
                                            <div style="height: 2px; background-color: #cbd0d6; width: 100%;"></div>
                                            <i class="fas fa-plane text-400 position-absolute bg-white px-2" style="left: 50%; transform: translateX(-50%); top: -7px;"></i>
                                            <!-- Dots on ends -->
                                            <div class="position-absolute bg-white border border-400 rounded-circle" style="width: 8px; height: 8px; left: 0; top: -3px;"></div>
                                            <div class="position-absolute bg-white border border-400 rounded-circle" style="width: 8px; height: 8px; right: 0; top: -3px;"></div>
                                        </div>
                                        <div class="fs--2 text-600 fw-semi-bold">
                                            <i class="far fa-clock me-1 d-none d-md-inline"></i>@durationStr • <span class="text-danger fw-bold">Direct</span>
                                        </div>
                                    </div>
                                    
                                    <!-- Arrival -->
                                    <div class="col-4 text-start ps-0 ps-md-3">
                                        <h3 class="mb-0 fw-bolder text-black">@item.ArrivalDateTime.ToString("HH:mm")</h3>
                                        <div class="fs--1 text-700 fw-bold mt-1 text-truncate" title="@(item.Airport_To?.Name)">
                                            @(item.Airport_To?.GovernerateState?.Name ?? "CAI")
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Price & Actions -->
                            <div class="col-12 col-md-3 text-md-end border-start-md border-200 ps-md-4 mt-4 mt-md-0 d-flex flex-column justify-content-center">
                                <h3 class="mb-3 text-black fw-bolder">EGP @item.Price.ToString("N0")</h3>
                                
                                <div class="d-flex justify-content-md-end gap-2 mt-auto">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning flex-grow-1 fw-bold text-black" style="background-color: #ffc107; border: none; flex-basis: 0;">
                                         Edit
                                    </a>
                                    
                                    <button type="button" class="btn btn-danger flex-grow-1 fw-bold text-white btn-delete-flight" data-url="/Admin/Trip/Delete/@item.Id" style="background-color: #e63757; border: none; flex-basis: 0;">
                                         Delete
                                    </button>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="card border-0 shadow-sm py-5 text-center" style="border-radius: 1rem !important; background-color: #f8f9fa;">
                <div class="card-body">
                    <div class="display-3 text-300 mb-3"><i class="fas fa-plane-slash"></i></div>
                    <h4 class="text-700 fw-bold">No flights found</h4>
                    <p class="text-500 mb-4">Try adjusting your search filters to find available trips.</p>
                    <a href="/Admin/Trip" class="btn btn-outline-primary rounded-pill px-4 fw-semi-bold">Clear all filters</a>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if(totalPages > 1) {
        <partial name="_AdminPaginationPartial" />
    }
</div>

<style>
    .hover-shadow {
        transition: box-shadow 0.3s ease, transform 0.3s ease;
    }
    .hover-shadow:hover {
        box-shadow: 0 10px 20px rgba(0,0,0,.08) !important;
        transform: translateY(-2px);
    }
    .flight-card {
        background-color: #fff;
    }
    .border-start-md {
        border-left: 1px solid #e3e6ed;
    }
    @@media (max-width: 767.98px) {
        .border-start-md {
            border-left: none;
            border-top: 1px solid #e3e6ed;
            padding-top: 1rem;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const deleteButtons = document.querySelectorAll(".btn-delete-flight");

        deleteButtons.forEach(button => {
            button.addEventListener("click", function (e) {
                e.preventDefault();
                const url = this.getAttribute("data-url");

                Swal.fire({
                    title: "Delete Flight?",
                    text: "This will permanently remove this flight schedule!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#e63757",
                    cancelButtonColor: "#2c7be5",
                    confirmButtonText: "Yes, delete it"
                }).then((result) => {
                    if (result.isConfirmed) {
                        const form = document.createElement('form');
                        form.method = 'POST';
                        form.action = url;
                        document.body.appendChild(form);
                        form.submit();
                    }
                });
            });
        });

        // Sorting behavior
        const sortButtons = document.querySelectorAll(".sort-btn");
        const sortInput = document.getElementById("sortOrderInput");
        const searchForm = document.getElementById("searchForm");
        
        sortButtons.forEach(btn => {
            btn.addEventListener("click", function(e) {
                e.preventDefault();
                const sortValue = this.getAttribute("data-sort");
                sortInput.value = sortValue;
                searchForm.submit();
            });
        });
    });
</script>

@section Scripts {
    <partial name="_NotificationPartial" />
}
