@model IEnumerable<Trip>
@{
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 10;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var searchBy = ViewBag.SearchBy as string ?? "all";
    var totalItems = ViewBag.TotalItems as int? ?? 0;
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-airplane-engines"></i> Trips Management
        </h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Trip
        </a>
    </div>

    <!-- Enhanced Search Form -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">
                <i class="bi bi-search"></i> Search Trips
            </h5>
            <form asp-action="Index" method="get" class="row g-3">
                <input type="hidden" name="page" value="1" />
                
                <div class="col-md-4">
                    <label class="form-label">Search Term</label>
                    <div class="input-group">
                        <input type="text" name="searchTerm" value="@searchTerm" 
                               class="form-control" placeholder="Enter search term..." />
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                </div>
                
                <div class="col-md-3">
                    <label class="form-label">Search By</label>
                    <select name="searchBy" class="form-select">
                        @if (searchBy == "all")
                        {
                            <option value="all" selected>🔍 All Fields</option>
                        }
                        else
                        {
                            <option value="all">🔍 All Fields</option>
                        }
                        @if (searchBy == "from")
                        {
                            <option value="from" selected>🛫 From Airport</option>
                        }
                        else
                        {
                            <option value="from">🛫 From Airport</option>
                        }
                        @if (searchBy == "to")
                        {
                            <option value="to" selected>🛬 To Airport</option>
                        }
                        else
                        {
                            <option value="to">🛬 To Airport</option>
                        }
                        @if (searchBy == "route")
                        {
                            <option value="route" selected>🛩️ Route</option>
                        }
                        else
                        {
                            <option value="route">🛩️ Route</option>
                        }
                        @if (searchBy == "airplane")
                        {
                            <option value="airplane" selected>✈️ Airplane</option>
                        }
                        else
                        {
                            <option value="airplane">✈️ Airplane</option>
                        }
                        @if (searchBy == "price")
                        {
                            <option value="price" selected>💰 Max Price</option>
                        }
                        else
                        {
                            <option value="price">💰 Max Price</option>
                        }
                    </select>
                </div>
                
                <div class="col-md-2">
                    <label class="form-label">Page Size</label>
                    <select name="pageSize" class="form-select" onchange="this.form.submit()">
                        @if (pageSize == 5)
                        {
                            <option value="5" selected>5</option>
                        }
                        else
                        {
                            <option value="5">5</option>
                        }
                        @if (pageSize == 10)
                        {
                            <option value="10" selected>10</option>
                        }
                        else
                        {
                            <option value="10">10</option>
                        }
                        @if (pageSize == 25)
                        {
                            <option value="25" selected>25</option>
                        }
                        else
                        {
                            <option value="25">25</option>
                        }
                        @if (pageSize == 50)
                        {
                            <option value="50" selected>50</option>
                        }
                        else
                        {
                            <option value="50">50</option>
                        }
                    </select>
                </div>
                
                <div class="col-md-3">
                    <label class="form-label">&nbsp;</label>
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-clockwise"></i> Clear
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Search Results Summary -->
    @if (!string.IsNullOrEmpty(searchTerm))
    {
        <div class="alert alert-info mb-3">
            <i class="bi bi-info-circle"></i> Found <strong>@totalItems</strong> trips 
            matching "<strong>@searchTerm</strong>" in <strong>@searchBy</strong> 
            @if (totalItems > pageSize)
            {
                <text>- Page @currentPage of @totalPages</text>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light mb-3">
            <i class="bi bi-list"></i> Showing <strong>@totalItems</strong> total trips
            @if (totalItems > pageSize)
            {
                <text>- Page @currentPage of @totalPages</text>
            }
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">🛫 Departure</th>
                            <th scope="col">🛬 Arrival</th>
                            <th scope="col">💰 Price</th>
                            <th scope="col">🛩️ Route</th>
                            <th scope="col">✈️ Airplane</th>
                            <th scope="col">🔧 Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <th scope="row">@item.Id</th>
                                    <td>
                                        <small class="text-muted">@item.DateTime.ToString("MMM dd")</small><br/>
                                        <strong>@item.DateTime.ToString("HH:mm")</strong>
                                    </td>
                                    <td>
                                        <small class="text-muted">@item.ArrivalDateTime.ToString("MMM dd")</small><br/>
                                        <strong>@item.ArrivalDateTime.ToString("HH:mm")</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-success fs-6">@item.Price.ToString("C")</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="badge bg-primary me-1">@item.Airport_From?.Name ?? "Unknown"</span>
                                            <i class="bi bi-arrow-right text-muted"></i>
                                            <span class="badge bg-info ms-1">@item.Airport_To?.Name ?? "Unknown"</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@item.Airplane?.Model ?? "Unknown"</span>
                                    </td>
                                    <td class="d-flex flex-row gap-2">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           asp-route-page="@currentPage"
                                           asp-route-searchTerm="@searchTerm"
                                           asp-route-searchBy="@searchBy"
                                           class="btn btn-warning btn-sm">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              asp-route-page="@currentPage"
                                              asp-route-searchTerm="@searchTerm"
                                              asp-route-searchBy="@searchBy"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this Trip?');">
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="bi bi-search fs-1"></i>
                                        <p class="mt-2">No trips found matching your criteria.</p>
                                        <a asp-action="Index" class="btn btn-outline-primary">Clear Search</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Enhanced Pagination -->
    @if (totalPages > 1)
    {
        <nav aria-label="Trips pagination" class="mt-4">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-muted">
                    Showing @((currentPage - 1) * pageSize + 1)-@(Math.Min(currentPage * pageSize, totalItems)) of @totalItems trips
                </div>
                <ul class="pagination mb-0">
                    @if (currentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" 
                               asp-action="Index" 
                               asp-route-page="@(currentPage - 1)"
                               asp-route-searchTerm="@searchTerm"
                               asp-route-searchBy="@searchBy">
                                <i class="bi bi-chevron-left"></i> Previous
                            </a>
                        </li>
                    }

                    @* Show page numbers with smart pagination *@
                    @{
                        var startPage = Math.Max(1, currentPage - 2);
                        var endPage = Math.Min(totalPages, currentPage + 2);
                        
                        if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-searchTerm="@searchTerm" asp-route-searchBy="@searchBy">1</a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        
                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" 
                                   asp-action="Index" 
                                   asp-route-page="@i"
                                   asp-route-searchTerm="@searchTerm"
                                   asp-route-searchBy="@searchBy">
                                    @i
                                </a>
                            </li>
                        }
                        
                        if (endPage < totalPages)
                        {
                            if (endPage < totalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="@totalPages" asp-route-searchTerm="@searchTerm" asp-route-searchBy="@searchBy">@totalPages</a>
                            </li>
                        }
                    }

                    @if (currentPage < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" 
                               asp-action="Index" 
                               asp-route-page="@(currentPage + 1)"
                               asp-route-searchTerm="@searchTerm"
                               asp-route-searchBy="@searchBy">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const deleteButtons = document.querySelectorAll(".btn-delete");

        deleteButtons.forEach(button => {
            button.addEventListener("click", function (e) {
                e.preventDefault();
                const url = this.getAttribute("href");

                Swal.fire({
                    title: "Delete Trip?",
                    text: "This will permanently remove this flight schedule!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#3085d6",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });
        });
    });
</script>

@section Scripts {
    <partial name="_NotificationPartial" />
}
