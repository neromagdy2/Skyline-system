@using Airport_Managment_SYS.Areas.Admin.ViewModels
@model CreateTripVM

<div class="container">
    <div class="row mb-3 align-items-center my-3">
        <div class="col-md-6">
            <h2 class="display-6">Create New Trip</h2>
        </div>
    </div>
    <div class="row my-3">
        <div class="col-12">
            <form method="post">
                @* Price Field *@
                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Ticket Price</label>
                    <input type="number" step="0.01" class="form-control" asp-for="Price">
                    <span class="text-danger" asp-validation-for="Price"></span>
                </div>

                @* DateTime Fields *@
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DateTime" class="form-label">Departure Date & Time</label>
                        <input type="datetime-local" class="form-control" asp-for="DateTime" min="@DateTime.Now">
                        <span class="text-danger" asp-validation-for="DateTime"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ArrivalDateTime" class="form-label">Arrival Date & Time</label>
                        <input type="datetime-local" class="form-control" asp-for="ArrivalDateTime" min="@DateTime.Now.AddMinutes(30)">
                        <span class="text-danger" asp-validation-for="ArrivalDateTime"></span>
                    </div>
                </div>

                <div class="row">
                    @* Departure Airport *@
                    <div class="col-md-6 mb-3">
                        <label asp-for="Airport_FromId" class="form-label">From Airport</label>
                        <select asp-for="Airport_FromId" class="form-select">
                            <option value="">-- Select Departure --</option>
                            @foreach (var airport in Model.Airports)
                            {
                                if (Model.Airport_FromId == airport.Id)
                                {
                                    <option value="@airport.Id" selected>@airport.Name</option>
                                }
                                else
                                {
                                    <option value="@airport.Id">@airport.Name</option>
                                }
                            }
                        </select>
                        <span class="text-danger" asp-validation-for="Airport_FromId"></span>
                    </div>

                    @* Arrival Airport *@
                    <div class="col-md-6 mb-3">
                        <label asp-for="Airport_ToId" class="form-label">To Airport</label>
                        <select asp-for="Airport_ToId" class="form-select">
                            <option value="">-- Select Destination --</option>
                            @foreach (var airport in Model.Airports)
                            {
                                if (Model.Airport_ToId == airport.Id)
                                {
                                    <option value="@airport.Id" selected>@airport.Name</option>
                                }
                                else
                                {
                                    <option value="@airport.Id">@airport.Name</option>
                                }
                            }
                        </select>
                        <span class="text-danger" asp-validation-for="Airport_ToId"></span>
                    </div>
                </div>

                <div class="row">
                    @* Airplane *@
                    <div class="col-md-6 mb-3">
                        <label asp-for="AirplaneId" class="form-label">Airplane</label>
                        <select asp-for="AirplaneId" class="form-select">
                            <option value="">-- Select Airplane --</option>
                            @foreach (var plane in Model.Airplanes)
                            {
                                if (Model.AirplaneId == plane.Id)
                                {
                                    <option value="@plane.Id" selected>@plane.Name</option>
                                }
                                else
                                {
                                    <option value="@plane.Id">@plane.Name</option>
                                }
                            }
                        </select>
                        <span class="text-danger" asp-validation-for="AirplaneId"></span>
                    </div>

                </div>

                <button type="submit" class="btn btn-primary">Create Trip</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_NotificationPartial" />

}
