@using Airport_Managment_SYS.Areas.Admin.ViewModels
@model CreateTripVM

<div class="container-fluid py-3 px-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-0 text-900">Create New Trip</h4>
            <p class="text-500 mb-0 fs--1">Schedule a new flight route.</p>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
    </div>

    <div class="card shadow-sm border-0" style="border-radius: 0.75rem;">
        <div class="card-body p-4">
            <form method="post">
                <!-- Validation Summary -->
                <div asp-validation-summary="All" class="text-danger fw-bold mb-3 bg-soft-danger p-2 rounded-3 fs--1" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <div class="row g-3">
                    <!-- Row 1: Airplane + Price -->
                    <div class="col-md-6">
                        <label class="form-label fw-semi-bold text-700 fs--1 mb-1"><i class="fas fa-plane text-primary me-1"></i>Airplane</label>
                        <select asp-for="AirplaneId" class="form-select form-select-sm border-200 shadow-sm">
                            <option value="">-- Select Airplane --</option>
                            @foreach (var plane in Model.Airplanes)
                            {
                                <option value="@plane.Id" @(Model.AirplaneId == plane.Id ? "selected" : "")>@plane.Name (@plane.Model)</option>
                            }
                        </select>
                        <span class="text-danger fs--2" asp-validation-for="AirplaneId"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semi-bold text-700 fs--1 mb-1"><i class="fas fa-tag text-warning me-1"></i>Ticket Price (EGP)</label>
                        <input type="number" step="0.01" class="form-control form-control-sm border-200 shadow-sm" asp-for="Price" placeholder="0.00">
                        <span class="text-danger fs--2" asp-validation-for="Price"></span>
                    </div>

                    <!-- Row 2: From + To -->
                    <div class="col-md-6">
                        <label class="form-label fw-semi-bold text-700 fs--1 mb-1"><i class="fas fa-plane-departure text-success me-1"></i>From Airport</label>
                        <select asp-for="Airport_FromId" class="form-select form-select-sm border-200 shadow-sm">
                            <option value="">-- Departure --</option>
                            @foreach (var airport in Model.Airports)
                            {
                                <option value="@airport.Id" @(Model.Airport_FromId == airport.Id ? "selected" : "")>@airport.Name @(airport.GovernerateState != null ? "- " + airport.GovernerateState.Name : "")</option>
                            }
                        </select>
                        <span class="text-danger fs--2" asp-validation-for="Airport_FromId"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semi-bold text-700 fs--1 mb-1"><i class="fas fa-plane-arrival text-info me-1"></i>To Airport</label>
                        <select asp-for="Airport_ToId" class="form-select form-select-sm border-200 shadow-sm">
                            <option value="">-- Destination --</option>
                            @foreach (var airport in Model.Airports)
                            {
                                <option value="@airport.Id" @(Model.Airport_ToId == airport.Id ? "selected" : "")>@airport.Name @(airport.GovernerateState != null ? "- " + airport.GovernerateState.Name : "")</option>
                            }
                        </select>
                        <span class="text-danger fs--2" asp-validation-for="Airport_ToId"></span>
                    </div>

                    <!-- Row 3: Departure + Arrival datetime -->
                    <div class="col-md-6">
                        <label class="form-label fw-semi-bold text-700 fs--1 mb-1"><i class="fas fa-clock text-primary me-1"></i>Departure Time</label>
                        <input type="datetime-local" class="form-control form-control-sm border-200 shadow-sm" asp-for="DateTime" id="departureTime">
                        <span class="text-danger fs--2" asp-validation-for="DateTime"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semi-bold text-700 fs--1 mb-1"><i class="fas fa-flag-checkered text-danger me-1"></i>Arrival Time</label>
                        <input type="datetime-local" class="form-control form-control-sm border-200 shadow-sm" asp-for="ArrivalDateTime" id="arrivalTime">
                        <span class="text-danger fs--2" asp-validation-for="ArrivalDateTime"></span>
                    </div>

                    <!-- Submit -->
                    <div class="col-12 text-end mt-3">
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm" style="background-color: #137fec; border-color: #137fec;">
                            <i class="fas fa-plus-circle me-2"></i>Publish Trip
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_NotificationPartial" />
    <script>
        document.getElementById('departureTime').addEventListener('change', function () {
            var dep = new Date(this.value);
            if (!isNaN(dep)) {
                var arr = document.getElementById('arrivalTime');
                if (!arr.value) {
                    dep.setHours(dep.getHours() + 2);
                    arr.value = new Date(dep - dep.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
                }
            }
        });
    </script>
}
