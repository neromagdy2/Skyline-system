@using Airport_Managment_SYS.Areas.Admin.ViewModels
@model CreateTripVM

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1 text-900">Create New Trip</h2>
                    <p class="text-500 mb-0">Schedule a new flight and configure its route, timing, and pricing.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semi-bold shadow-sm">
                    <i class="fas fa-arrow-left me-2"></i>Back to Trips
                </a>
            </div>

            <!-- Form Card -->
            <div class="card shadow-sm border-0" style="border-radius: 1rem;">
                <div class="card-body p-4 p-md-5">
                    
                    <form method="post" id="createTripForm">
                        
                        <!-- Validation Summary for hidden/implicit errors -->
                        <div asp-validation-summary="All" class="text-danger fw-bold mb-4 bg-soft-danger p-3 rounded-3" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                        <div class="row g-4">
                            
                            <!-- FLIGHT DETAILS SECTION -->
                            <div class="col-12">
                                <h5 class="text-700 fw-bold mb-3 border-bottom pb-2"><i class="fas fa-plane text-primary me-2"></i>Flight Details</h5>
                            </div>
                            
                            <!-- Airplane -->
                            <div class="col-md-6">
                                <label asp-for="AirplaneId" class="form-label fw-semi-bold text-700">Select Airplane</label>
                                <div class="form-floating shadow-sm rounded-3">
                                    <select asp-for="AirplaneId" class="form-select rounded-3 border-200" id="airplaneSelect">
                                        <option value="">-- Choose an Airplane --</option>
                                        @foreach (var plane in Model.Airplanes)
                                        {
                                            if (Model.AirplaneId == plane.Id)
                                            {
                                                <option value="@plane.Id" selected>@plane.Name (@plane.Model)</option>
                                            }
                                            else
                                            {
                                                <option value="@plane.Id">@plane.Name (@plane.Model)</option>
                                            }
                                        }
                                    </select>
                                    <label for="airplaneSelect">Airplane</label>
                                </div>
                                <span class="text-danger fs--1 fw-semi-bold mt-1 d-block" asp-validation-for="AirplaneId"></span>
                            </div>

                            <!-- Ticket Price -->
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-semi-bold text-700">Ticket Price (EGP)</label>
                                <div class="form-floating shadow-sm rounded-3">
                                    <input type="number" step="0.01" class="form-control rounded-3 border-200" asp-for="Price" id="priceInput" placeholder="0.00">
                                    <label for="priceInput">Price</label>
                                </div>
                                <span class="text-danger fs--1 fw-semi-bold mt-1 d-block" asp-validation-for="Price"></span>
                            </div>

                            <!-- ROUTING SECTION -->
                            <div class="col-12 mt-5">
                                <h5 class="text-700 fw-bold mb-3 border-bottom pb-2"><i class="fas fa-map-marked-alt text-success me-2"></i>Routing</h5>
                            </div>

                            <!-- Departure Airport -->
                            <div class="col-md-6">
                                <label asp-for="Airport_FromId" class="form-label fw-semi-bold text-700">Departure Airport</label>
                                <div class="form-floating shadow-sm rounded-3">
                                    <select asp-for="Airport_FromId" class="form-select rounded-3 border-200" id="fromSelect">
                                        <option value="">-- Origin --</option>
                                        @foreach (var airport in Model.Airports)
                                        {
                                            if (Model.Airport_FromId == airport.Id)
                                            {
                                                <option value="@airport.Id" selected>@airport.Name - @airport.GovernerateState?.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@airport.Id">@airport.Name - @airport.GovernerateState?.Name</option>
                                            }
                                        }
                                    </select>
                                    <label for="fromSelect"><i class="fas fa-plane-departure text-400 me-2"></i>From</label>
                                </div>
                                <span class="text-danger fs--1 fw-semi-bold mt-1 d-block" asp-validation-for="Airport_FromId"></span>
                            </div>

                            <!-- Arrival Airport -->
                            <div class="col-md-6">
                                <label asp-for="Airport_ToId" class="form-label fw-semi-bold text-700">Destination Airport</label>
                                <div class="form-floating shadow-sm rounded-3">
                                    <select asp-for="Airport_ToId" class="form-select rounded-3 border-200" id="toSelect">
                                        <option value="">-- Destination --</option>
                                        @foreach (var airport in Model.Airports)
                                        {
                                            if (Model.Airport_ToId == airport.Id)
                                            {
                                                <option value="@airport.Id" selected>@airport.Name - @airport.GovernerateState?.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@airport.Id">@airport.Name - @airport.GovernerateState?.Name</option>
                                            }
                                        }
                                    </select>
                                    <label for="toSelect"><i class="fas fa-plane-arrival text-400 me-2"></i>To</label>
                                </div>
                                <span class="text-danger fs--1 fw-semi-bold mt-1 d-block" asp-validation-for="Airport_ToId"></span>
                            </div>

                            <!-- SCHEDULE SECTION -->
                            <div class="col-12 mt-5">
                                <h5 class="text-700 fw-bold mb-3 border-bottom pb-2"><i class="fas fa-clock text-warning me-2"></i>Schedule</h5>
                            </div>

                            <!-- Departure Time -->
                            <div class="col-md-6">
                                <label asp-for="DateTime" class="form-label fw-semi-bold text-700">Departure Time</label>
                                <div class="form-floating shadow-sm rounded-3">
                                    <input type="datetime-local" class="form-control rounded-3 border-200" asp-for="DateTime" id="departureTime" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")">
                                    <label for="departureTime">Takeoff</label>
                                </div>
                                <span class="text-danger fs--1 fw-semi-bold mt-1 d-block" asp-validation-for="DateTime"></span>
                            </div>

                            <!-- Arrival Time -->
                            <div class="col-md-6">
                                <label asp-for="ArrivalDateTime" class="form-label fw-semi-bold text-700">Arrival Time</label>
                                <div class="form-floating shadow-sm rounded-3">
                                    <input type="datetime-local" class="form-control rounded-3 border-200" asp-for="ArrivalDateTime" id="arrivalTime" min="@DateTime.Now.AddMinutes(30).ToString("yyyy-MM-ddTHH:mm")">
                                    <label for="arrivalTime">Landing</label>
                                </div>
                                <span class="text-danger fs--1 fw-semi-bold mt-1 d-block" asp-validation-for="ArrivalDateTime"></span>
                            </div>

                            <!-- Submit Button -->
                            <div class="col-12 mt-5 text-end">
                                <hr class="border-200 mb-4" />
                                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm" style="background-color: #137fec; border-color: #137fec;">
                                    <i class="fas fa-plus-circle me-2"></i> Publish Trip Schedule
                                </button>
                            </div>
                            
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_NotificationPartial" />
    <script>
        // Optional: Auto-adjust arrival time if departure changes
        document.getElementById('departureTime').addEventListener('change', function() {
            var depTime = new Date(this.value);
            if (!isNaN(depTime.getTime())) {
                // Default arrival to +2 hours if not set
                var arrInput = document.getElementById('arrivalTime');
                if (!arrInput.value) {
                    depTime.setHours(depTime.getHours() + 2);
                    // Format back to datetime-local
                    var tzoffset = (new Date()).getTimezoneOffset() * 60000;
                    var localISOTime = (new Date(depTime - tzoffset)).toISOString().slice(0, 16);
                    arrInput.value = localISOTime;
                }
            }
        });
    </script>
}
