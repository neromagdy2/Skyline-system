@model IEnumerable<Airport_Managment_SYS.Models.Reservation>

@{
 Layout = "~/Views/Shared/_admin_layout.cshtml";
}

@* <h2>Reservations</h2> *@

@* <p> *@
@*  <a asp-area="Admin" asp-controller="Reservation" asp-action="Create" class="btn btn-success">Create Reservation</a> *@
@* </p> *@
<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Reservation Management</h2>
        <a asp-action="Create" class="btn btn-primary">
            + Add New Reservation
        </a>
    </div>

@if (!Model.Any())
{
 <div class="alert alert-info">No reservations found.</div>
}

@* <table class="table table-bordered table-striped"> *@
@*  <thead> *@

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-striped table-hover align-middle text-center">
                <thead class="table-dashboard">
                <tr>
                 <th>Trip Id</th>
                 <th>Trip Date</th>
                 <th>Price</th>
                 <th>User Id</th>
                 <th>User Name</th>
                 <th>User Email</th>
                 <th>Actions</th>
                </tr>
               </thead>

       <tbody>
          @foreach (var r in Model)
          {
             <tr>
             <td>@r.TripId</td>
             <td>@(r.Trip?.DateTime.ToString("g") ?? "-")</td>
             <td>@(r.Trip?.Price.ToString("C") ?? "-")</td>
             <td>@r.ApplicationUserId</td>
             <td>@(r.ApplicationUser?.UserName ?? "-")</td>
             <td>@(r.ApplicationUser?.Email ?? "-")</td>
             <td>
             <a asp-area="Admin" asp-controller="Reservation" asp-action="Edit" asp-route-tripId="@r.TripId" asp-route-userId="@r.ApplicationUserId" class="btn btn-warning">Edit</a>

             <form asp-area="Admin" asp-controller="Reservation" asp-action="Delete" method="post" style="display:inline">
             @Html.AntiForgeryToken()
           <input type="hidden" name="tripId" value="@r.TripId" />
           <input type="hidden" name="userId" value="@r.ApplicationUserId" />
            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this reservation?');">Delete</button>
              </form>
              </td>
          </tr>
                 }
        </tbody>
            </table>

        </div>
    </div>

