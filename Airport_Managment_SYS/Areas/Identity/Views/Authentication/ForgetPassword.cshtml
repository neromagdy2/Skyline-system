@model Airport_Managment_SYS.ViewModels.ForgetPasswordVM

<div class="container d-flex justify-content-center align-items-center" style="min-height:100vh;">
    <div class="card shadow-lg p-4" style="max-width:450px; width:100%;">
        <h3 class="text-center mb-3">Forgot Password</h3>
        <p class="text-center text-muted mb-4">
            Enter your email and we’ll send you a reset link
        </p>

        <form asp-action="ForgetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="EmailOrUsername" class="form-label"></label>
                <input asp-for="EmailOrUsername" class="form-control" />
                <span asp-validation-for="EmailOrUsername" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Send Reset Link
            </button>
        </form>

        <hr />

        <!-- رجوع للـ Login -->
        <div class="text-center mt-3">
            <p class="text-muted mb-1">Remember your password?</p>
            <a asp-action="Login" class="btn btn-outline-secondary w-100">
                Back to Login
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <partial name="_NotificationPartial" />
    }
}
