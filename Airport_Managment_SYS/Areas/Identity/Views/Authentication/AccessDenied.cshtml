<div class="container d-flex justify-content-center align-items-center" style="min-height:100vh;">
    <div class="card shadow-lg p-4" style="max-width:650px; width:100%;">
        <h3 class="mb-2">Access Denied</h3>
        <p class="text-muted mb-4">You don’t have permission to access this page.</p>

        <div class="d-flex gap-2">
            <a asp-area="Identity" asp-controller="Profile" asp-action="Index" class="btn btn-outline-primary">Go to Profile</a>
            <a asp-area="Identity" asp-controller="Authentication" asp-action="Login" class="btn btn-outline-secondary">Login</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        <partial name="_NotificationPartial" />
    }
}

