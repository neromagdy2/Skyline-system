@using Airport_Managment_SYS.Areas.Identity.ViewModels
@model EditProfileVM
@inject Airport_Managment_SYS.DataAccess.ApplicationDbcontext context

@{
    var nationalities = context.Nationalities.OrderBy(n => n.Name).ToList();
}

<div class="container d-flex justify-content-center align-items-center" style="min-height:100vh;">
    <div class="card shadow-lg p-4" style="max-width:650px; width:100%;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="mb-0">Update Profile</h3>
                <p class="text-muted mb-0">Edit your account details</p>
            </div>
            <a asp-area="Identity" asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>

        <form asp-area="Identity" asp-controller="Profile" asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NationalitiesId" class="form-label"></label>
                <select asp-for="NationalitiesId" class="form-control">
                    <option value="">-- Select Nationality --</option>
                    @foreach (var nationality in nationalities)
                    {
                        <option value="@nationality.Id">@nationality.Name</option>
                    }
                </select>
                <span asp-validation-for="NationalitiesId" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-area="Identity" asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <partial name="_NotificationPartial" />
    }
}

