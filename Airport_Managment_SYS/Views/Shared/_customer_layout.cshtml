<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SkyStream</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- SkyStream Custom Styles -->
    <link rel="stylesheet" href="~/css/_customer_layout_style.css" />
</head>
<body class="mesh-bg">
    <div class="d-flex flex-column min-vh-100">
        <!-- Header -->
        <header class="site-header">
            <div class="container-fluid px-4 px-lg-5" style="max-width: 1400px; margin: 0 auto;">
                <div class="d-flex align-items-center justify-content-between py-3">
                    <!-- Logo -->
                    <a href="/Customer/Home/Index" class="d-flex align-items-center gap-2 text-decoration-none">
                        <div class="logo-icon">
                            <i class="bi bi-airplane-fill"></i>
                        </div>
                        <span class="logo-text">SKYSTREAM</span>
                    </a>

                    <!-- Desktop Navigation -->
                    <nav class="d-none d-md-flex align-items-center gap-4">
                        <a class="nav-link-custom" href="/Customer/Home/Index">Home</a>
                        <a class="nav-link-custom" href="/Customer/Home/Bookings">Bookings</a>
                    </nav>

                    <!-- Right Side Actions -->
                    <div class="d-flex align-items-center gap-3">
                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <a class="btn-admin d-none d-sm-inline-block" href="/Admin/Home/Index">AdminMode</a>
                        }
                        <a href="/Identity/Authentication/Logout" class="btn-logout">Logout</a>
                        <a href="/Customer/Profile/Index">
                            <div class="avatar" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAjNZ4wG5KCPYB1K3AaZdxZJuUNnNgFfpdUYNd_rq1JId-Lvs3UF-Kqb61ShVGFLfB3uLYHNOn0ti5BQMekCbjY7uDxpC6oZHjMOPjeEjHI9dJOrb8RmpI7iR_Bjvwc5xp3M624fdSPtEO34yQy1ck-po98QuUNpR5PUfj9xihpZc874yDHDkOJmHGgCPVERQie71v7JEvkKIP178RocKwM6APBANUnRDRfkvHsq0UuLef_vVl4Nrbir8KWmVmLNxqQLiH9GvkIEuU");'></div>
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-grow-1">
            <div class="container-fluid px-4 px-lg-5" style="max-width: 1400px; margin: 0 auto;">
                @RenderBody()
            </div>
        </main>

        <!-- Chat Toggle Button -->
        <button id="chatToggle" class="chat-toggle">
            <img src="~/assets/logos/chatot.png" alt="Chat" />
            <span class="d-none d-sm-inline">ask chat</span>
        </button>

        <!-- Chatbot Container -->
        <div id="chatbot" class="chatbot-container glass-card rounded-4 shadow-xl">
            <!-- Header -->
            <div class="chat-header">
                <div class="d-flex align-items-center gap-2">
                    <img src="~/assets/logos/chatot.png" alt="Chat" style="width: 40px; height: 40px;" />
                    <span class="fw-bold">Chatbot</span>
                </div>
                <button id="closeChat" class="btn btn-link text-white p-0 border-0">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Body -->
            <div id="chatBody" class="chat-body">
                <!-- Questions will be loaded here -->
            </div>
        </div>

        <!-- Footer -->
        <footer class="site-footer">
            <div class="footer-glow"></div>
            <div class="container-fluid px-4 px-lg-5" style="max-width: 1400px; margin: 0 auto;">
                <div class="row g-5">
                    <!-- Brand Column -->
                    <div class="col-12 col-lg-4">
                        <div class="mb-4">
                            <a href="/Customer/Home/Index" class="d-flex align-items-center gap-2 text-decoration-none mb-4">
                                <div class="logo-icon" style="width: 32px; height: 32px;">
                                    <i class="bi bi-airplane-fill" style="font-size: 1rem;"></i>
                                </div>
                                <span class="logo-text" style="font-size: 1.125rem;">SKYSTREAM</span>
                            </a>
                            <p class="text-secondary" style="line-height: 1.7; max-width: 320px;">
                                Pioneering the next era of global transportation. We merge architectural aesthetics with aviation precision to redefine every mile.
                            </p>
                        </div>
                        <div class="d-flex gap-3">
                            <a class="social-icon" href="#">
                                <i class="bi bi-globe"></i>
                            </a>
                            <a class="social-icon" href="#">
                                <i class="bi bi-at"></i>
                            </a>
                            <a class="social-icon" href="#">
                                <i class="bi bi-chat-dots"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Links Columns -->
                    <div class="col-12 col-lg-8">
                        <div class="row g-4">
                            <div class="col-6 col-md-4">
                                <h5 class="footer-heading">Orbit</h5>
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-3">
                                        <a class="footer-link" href="#">Fleet Portal</a>
                                    </li>
                                    <li class="mb-3">
                                        <a class="footer-link" href="#">Destinations</a>
                                    </li>
                                    <li class="mb-3">
                                        <a class="footer-link" href="#">Experience</a>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-6 col-md-4">
                                <h5 class="footer-heading">Support</h5>
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-3">
                                        <a class="footer-link" href="#">Help Systems</a>
                                    </li>
                                    <li class="mb-3">
                                        <a class="footer-link" href="#">Terms of Flight</a>
                                    </li>
                                    <li class="mb-3">
                                        <a class="footer-link" href="#">Protocols</a>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-12 col-md-4">
                                <h5 class="footer-heading">Dispatch</h5>
                                <div class="d-flex flex-column gap-3">
                                    <p class="text-secondary mb-0" style="font-size: 0.75rem;">Receive priority flight updates and route alerts.</p>
                                    <div class="position-relative">
                                        <input class="newsletter-input" placeholder="Enter your terminal email" type="email" />
                                        <button class="newsletter-btn">
                                            <i class="bi bi-arrow-right"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Bottom -->
                <div class="footer-bottom">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                        <p class="footer-bottom-link mb-0">&copy; 2024 SkyStream Aerospace Industries.</p>
                        <div class="d-flex gap-4 gap-md-5">
                            <a class="footer-bottom-link" href="#">Data Security</a>
                            <a class="footer-bottom-link" href="#">Global Policy</a>
                            <a class="footer-bottom-link" href="#">Terminal Access</a>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Chat Toggle
        const chatToggle = document.getElementById("chatToggle");
        const chatbot = document.getElementById("chatbot");
        const closeChat = document.getElementById("closeChat");

        chatToggle.onclick = () => {
        chatbot.classList.toggle("show");
        loadQuestions(null);
        };

        closeChat.onclick = () => {
        chatbot.classList.remove("show");
        };

        // Load Questions
        async function loadQuestions(parentId) {
        const res = await fetch(`/Customer/Home/GetQuestions?parentId=${parentId ?? ''}`);
        const data = await res.json();

        const chatBody = document.getElementById("chatBody");
        chatBody.innerHTML = "";

        data.forEach(q => {
        const btn = document.createElement("button");
        btn.className = "chat-question-btn";
        btn.innerText = q.question;
        btn.onclick = () => handleQuestionClick(q.id);
        chatBody.appendChild(btn);
        });
        }

        // Handle Question Click
        async function handleQuestionClick(id) {
        const res = await fetch(`/Customer/Home/GetQuestionWithChildren?id=${id}`);
        const data = await res.json();

        const chatBody = document.getElementById("chatBody");

        // Display Answer
        if (data.answer) {
        const aDiv = document.createElement("div");
        aDiv.className = "chat-answer";

        const aDivSpan = document.createElement("span");
        aDivSpan.className = "chat-answer-label";
        aDivSpan.innerText = "Answer is";
        aDiv.appendChild(aDivSpan);

        const aDivAnswer = document.createElement("p");
        aDivAnswer.className = "chat-answer-text";
        aDivAnswer.innerText = data.answer;
        aDiv.appendChild(aDivAnswer);

        chatBody.appendChild(aDiv);
        }

        // Display Children
        data.children.forEach(child => {
        const btn = document.createElement("button");
        btn.className = "chat-child-btn";
        btn.innerText = child.question;
        btn.onclick = () => handleQuestionClick(child.id);
        chatBody.appendChild(btn);
        });

        // Scroll to bottom
        chatBody.scrollTop = chatBody.scrollHeight;
        }

        function showAnswer(answer) {
        const chatBody = document.getElementById("chatBody");
        const div = document.createElement("div");
        div.className = "p-2 rounded";
        div.style.background = "rgba(59, 130, 246, 0.2)";
        div.innerText = answer;
        chatBody.appendChild(div);
        }
    </script>
</body>
</html>
