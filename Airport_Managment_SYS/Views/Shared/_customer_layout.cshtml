@using Airport_Managment_SYS.Utilities;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        .material-symbols-outlined { font-family: 'Material Symbols Outlined'; font-weight: 400; font-style: normal; font-size: inherit; line-height: 1; letter-spacing: normal; }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            console.log(@User.IsInRole("ADMIN")),
          darkMode: "class",
          theme: {
            extend: {
              colors: {
                "primary": "#137fec",
                "background-light": "#f8fafc",
                "background-dark": "#0f172a",
              },
              fontFamily: { "display": ["Plus Jakarta Sans", "sans-serif"] },
            },
          },
        }
    </script>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 antialiased min-h-screen flex flex-col">

    <!-- Navigation -->
    <header class="sticky top-0 z-50 border-b border-slate-200/60 dark:border-slate-800/60 bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl px-6 py-4 lg:px-20">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-2 text-primary">
                <span class="material-symbols-outlined text-3xl font-bold">flight_takeoff</span>
                <h2 class="text-xl font-800 tracking-tight text-slate-900 dark:text-white">SkyStream</h2>
            </div>
            <nav class="hidden md:flex items-center gap-8 text-sm font-semibold">
                <a class="text-slate-600 dark:text-slate-400 hover:text-primary transition-colors" href="/Customer/Home/Index">Home</a>
                <a class="text-slate-600 dark:text-slate-400 hover:text-primary transition-colors" href="/Customer/Home/Bookings">Bookings</a>
            </nav>
            <div>
                @*!! does Nothing !!*@
                <a class="rounded-full bg-primary px-6 py-2 text-sm font-bold text-white shadow-lg shadow-primary/20 hover:opacity-90" href="/Identity/Authentication/Logout">Logout</a>
                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                {
                    <a class="rounded-full bg-primary px-6 py-2 text-sm font-bold text-info shadow-lg shadow-primary/20 hover:opacity-90" style="background-color: sandybrown " href="/Admin/Home/Index">AdminMode</a>
                }

            </div>
        </div>
    </header>

    <!-- FIXED MAIN AREA -->
    <main class="flex-grow relative">
        <!-- Visual background grid -->
        <div class="absolute inset-0 -z-10 h-full w-full bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-50"></div>

        <!-- RenderBody Container -->
        <div class="max-w-7xl mx-auto px-6 py-10 lg:px-20">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 py-12 px-6 lg:px-20">
        <div class="max-w-7xl mx-auto text-center text-slate-500 text-sm">
            <p>� 2024 SkyStream Airlines. All rights reserved.</p>
        </div>
    </footer>

    <!-- REQUIRED FOR SCRIPTS TO WORK -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


