<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            console.log(@User.IsInRole("ADMIN")),
          darkMode: "class",
          theme: {
            extend: {
              colors: {
                "primary": "#3b82f6",
                "accent": "#0ea5e9",
                "background-dark": "#020617",
                "card-dark": "rgba(15, 23, 42, 0.6)",
              },
              fontFamily: {
                "display": ["Plus Jakarta Sans", "sans-serif"]
              },
              borderRadius: {"DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "2xl": "2.5rem", "full": "9999px"},
            },
          },
        }
    </script>
    <style>
        .glass {
            background: rgba(15, 23, 42, 0.4);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .glass-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.01) 100%);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glow-primary {
            box-shadow: 0 0 40px -10px rgba(59, 130, 246, 0.3);
        }

        .glow-text {
            text-shadow: 0 0 20px rgba(59, 130, 246, 0.5);
        }

        .mesh-bg {
            background-image: radial-gradient(at 0% 0%, rgba(59, 130, 246, 0.15) 0px, transparent 50%), radial-gradient(at 100% 0%, rgba(14, 165, 233, 0.1) 0px, transparent 50%), radial-gradient(at 50% 100%, rgba(30, 64, 175, 0.1) 0px, transparent 50%);
        }
    </style>
</head>
<body class="font-display antialiased mesh-bg bg-background-dark text-slate-200 selection:bg-primary/30 font-display antialiased mesh-bg">
    <div class="relative flex min-h-screen w-full flex-col">
        <header class="fixed-top top-0 z-50 flex items-center justify-between border-b border-white/5 bg-background-dark/60 backdrop-blur-xl px-6 py-4 lg:px-20" style="background-color:transparent">
            <div class="flex items-center gap-2 group cursor-pointer">
                <div class="relative flex items-center justify-center size-10 bg-primary/20 rounded-xl overflow-hidden group-hover:bg-primary/30 transition-all">
                    <span class="material-symbols-outlined text-primary text-2xl group-hover:scale-110 transition-transform">flight_takeoff</span>
                </div>
                <h2 class="text-xl font-800 leading-tight tracking-tighter text-white">SKYSTREAM</h2>
            </div>
            <nav class="hidden md:flex items-center gap-8 text-sm font-semibold">
                <a class="text-slate-600 dark:text-slate-400 hover:text-primary transition-colors text-white" href="/Customer/Home/Index">Home</a>
                <a class="text-slate-600 dark:text-slate-400 hover:text-primary transition-colors text-white" href="/Customer/Home/Bookings">Bookings</a>
            </nav>
            <div class="flex items-center gap-6">
                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                {
                    <a class="rounded-full bg-primary px-6 py-2 text-sm font-bold text-info shadow-lg shadow-primary/20 hover:opacity-90" style="background-color: sandybrown; " href="/Admin/Home/Index">AdminMode</a>
                }
                <a class="rounded-full bg-primary px-6 py-2 text-sm font-bold text-white shadow-lg shadow-primary/20 hover:opacity-90" href="/Identity/Authentication/Logout">Logout</a>
                <a href="/Customer/Profile/Index">
                    <div class="bg-slate-800 aspect-square bg-cover rounded-full size-10 border border-white/10" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAjNZ4wG5KCPYB1K3AaZdxZJuUNnNgFfpdUYNd_rq1JId-Lvs3UF-Kqb61ShVGFLfB3uLYHNOn0ti5BQMekCbjY7uDxpC6oZHjMOPjeEjHI9dJOrb8RmpI7iR_Bjvwc5xp3M624fdSPtEO34yQy1ck-po98QuUNpR5PUfj9xihpZc874yDHDkOJmHGgCPVERQie71v7JEvkKIP178RocKwM6APBANUnRDRfkvHsq0UuLef_vVl4Nrbir8KWmVmLNxqQLiH9GvkIEuU");'></div>
                </a>
            </div>
        </header>
    </div>

    <!-- FIXED MAIN AREA -->
    <main class="flex-grow relative">
        <!-- Visual background grid -->
        <div class="absolute inset-0 -z-10 h-full w-full bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-50"></div>

        <!-- RenderBody Container -->
        <div class="max-w-7xl mx-auto px-6  lg:px-20">
            @RenderBody()
        </div>
        <footer class="bg-background-dark border-t border-white/5 px-6 py-20 lg:px-20 relative overflow-hidden">
            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-3/4 h-1 bg-gradient-to-r from-transparent via-primary/50 to-transparent"></div>
            <div class="max-w-7xl mx-auto flex flex-col lg:flex-row justify-between gap-20 relative z-10">
                <div class="max-w-sm space-y-8">
                    <div class="flex items-center gap-2 group cursor-pointer">
                        <div class="size-8 bg-primary/20 rounded-lg flex items-center justify-center">
                            <span class="material-symbols-outlined text-primary text-xl">flight_takeoff</span>
                        </div>
                        <h2 class="text-lg font-800 text-white tracking-tighter uppercase">SKYSTREAM</h2>
                    </div>
                    <p class="text-slate-500 leading-relaxed">
                        Pioneering the next era of global transportation. We merge architectural aesthetics with aviation precision to redefine every mile.
                    </p>
                    <div class="flex gap-6">
                        <a class="size-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:border-primary/50 transition-all" href="#">
                            <span class="material-symbols-outlined text-xl">public</span>
                        </a>
                        <a class="size-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:border-primary/50 transition-all" href="#">
                            <span class="material-symbols-outlined text-xl">alternate_email</span>
                        </a>
                        <a class="size-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:border-primary/50 transition-all" href="#">
                            <span class="material-symbols-outlined text-xl">forum</span>
                        </a>
                    </div>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-16 flex-1">
                    <div class="space-y-6">
                        <h5 class="text-xs font-bold uppercase tracking-[0.3em] text-white">Orbit</h5>
                        <ul class="space-y-4 text-sm text-slate-500">
                            <li><a class="hover:text-primary transition-colors flex items-center gap-2" href="#">Fleet Portal</a></li>
                            <li><a class="hover:text-primary transition-colors flex items-center gap-2" href="#">Destinations</a></li>
                            <li><a class="hover:text-primary transition-colors flex items-center gap-2" href="#">Experience</a></li>
                        </ul>
                    </div>
                    <div class="space-y-6">
                        <h5 class="text-xs font-bold uppercase tracking-[0.3em] text-white">Support</h5>
                        <ul class="space-y-4 text-sm text-slate-500">
                            <li><a class="hover:text-primary transition-colors flex items-center gap-2" href="#">Help Systems</a></li>
                            <li><a class="hover:text-primary transition-colors flex items-center gap-2" href="#">Terms of Flight</a></li>
                            <li><a class="hover:text-primary transition-colors flex items-center gap-2" href="#">Protocols</a></li>
                        </ul>
                    </div>
                    <div class="space-y-6 col-span-2 md:col-span-1">
                        <h5 class="text-xs font-bold uppercase tracking-[0.3em] text-white">Dispatch</h5>
                        <div class="flex flex-col gap-4">
                            <p class="text-xs text-slate-600">Receive priority flight updates and route alerts.</p>
                            <div class="relative">
                                <input class="w-full h-12 rounded-xl border border-white/10 bg-white/5 px-4 text-xs focus:ring-primary focus:border-primary placeholder:text-slate-600 text-white" placeholder="Enter your terminal email" type="email" />
                                <button class="absolute right-1 top-1 h-10 w-10 bg-white text-background-dark rounded-lg flex items-center justify-center hover:bg-primary hover:text-white transition-all shadow-lg">
                                    <span class="material-symbols-outlined text-lg">arrow_forward</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="max-w-7xl mx-auto mt-24 pt-10 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-600">
                <p>© 2024 SkyStream Aerospace Industries.</p>
                <div class="flex gap-10">
                    <a class="hover:text-white transition-colors" href="#">Data Security</a>
                    <a class="hover:text-white transition-colors" href="#">Global Policy</a>
                    <a class="hover:text-white transition-colors" href="#">Terminal Access</a>
                </div>
            </div>
        </footer>
    </div>    <!-- REQUIRED FOR SCRIPTS TO WORK -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
