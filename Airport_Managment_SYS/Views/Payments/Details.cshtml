@model Airport_Managment_SYS.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
}

<h1>Details</h1>
<div>
    <h4>Payment Info</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Total Amount</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Total)</dd>

        <dt class="col-sm-2">User Name</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ApplicationUser.UserName)</dd>
    </dl>
</div>
<div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>