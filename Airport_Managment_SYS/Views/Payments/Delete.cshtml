@model Airport_Managment_SYS.Models.Payment

@{
    ViewData["Title"] = "Delete Payment";
}

<h1>Delete</h1>
<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Total</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Total)</dd>

        <dt class="col-sm-2">User</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ApplicationUser.UserName)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Confirm Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>